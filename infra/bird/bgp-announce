#!/usr/bin/env bash
# bgp-announce: health-controlled announcement switch for BIRD.
#
# bird.conf (generated by scripts/netgen) includes state.conf, which holds two
# constants that gate the export filters:
#   define ANNOUNCE = true|false;   false -> export nothing (withdraw)
#   define DRAIN    = true|false;   true  -> keep exporting, but prepend and tag
#                                            (GRACEFUL_SHUTDOWN + provider prepend)
# This script rewrites state.conf atomically and asks BIRD to reload. It is
# idempotent (no reload when nothing changes) so the health worker can call it
# every tick. It never touches bird.conf itself.
#
# Usage: bgp-announce status|announce|withdraw|drain|undrain
# Env:   BGP_STATE_FILE (default /etc/bird/state.conf)
#        BIRDC          (default birdc)
#        BGP_NO_RELOAD  (set to 1 to only rewrite the file; for tests)
set -euo pipefail

STATE_FILE=${BGP_STATE_FILE:-/etc/bird/state.conf}
BIRDC=${BIRDC:-birdc}

usage() {
  echo "usage: $(basename "$0") status|announce|withdraw|drain|undrain" >&2
  exit 2
}

read_state() {
  # Prints "ANNOUNCE DRAIN" as true/false words; missing file = withdrawn.
  local announce=false drain=false
  if [[ -r "$STATE_FILE" ]]; then
    announce=$(sed -n 's/^define ANNOUNCE *= *\(true\|false\) *;.*/\1/p' "$STATE_FILE" | tail -n1)
    drain=$(sed -n 's/^define DRAIN *= *\(true\|false\) *;.*/\1/p' "$STATE_FILE" | tail -n1)
    announce=${announce:-false}
    drain=${drain:-false}
  fi
  echo "$announce $drain"
}

write_state() {
  local announce=$1 drain=$2 tmp
  tmp=$(mktemp "${STATE_FILE}.XXXXXX")
  cat >"$tmp" <<EOF
# Rewritten by bgp-announce; do not edit by hand. bird.conf includes this file.
define ANNOUNCE = ${announce};
define DRAIN = ${drain};
EOF
  chmod 0644 "$tmp"
  mv -f "$tmp" "$STATE_FILE"
}

reload() {
  [[ "${BGP_NO_RELOAD:-0}" == "1" ]] && return 0
  local out
  if ! out=$("$BIRDC" configure check 2>&1) || ! grep -q "Configuration OK" <<<"$out"; then
    echo "bgp-announce: configuration check failed:" >&2
    echo "$out" >&2
    return 1
  fi
  if ! out=$("$BIRDC" configure 2>&1) || ! grep -Eq "Reconfigured|Reconfiguration in progress" <<<"$out"; then
    echo "bgp-announce: reconfigure failed:" >&2
    echo "$out" >&2
    return 1
  fi
}

set_state() {
  local announce=$1 drain=$2 cur prev_announce prev_drain
  cur=$(read_state)
  prev_announce=${cur% *}
  prev_drain=${cur#* }
  if [[ "$prev_announce" == "$announce" && "$prev_drain" == "$drain" ]]; then
    echo "bgp-announce: unchanged (ANNOUNCE=$announce DRAIN=$drain)"
    return 0
  fi
  local backup
  backup=$(mktemp "${STATE_FILE}.bak.XXXXXX")
  if [[ -r "$STATE_FILE" ]]; then cp "$STATE_FILE" "$backup"; else : >"$backup"; fi
  write_state "$announce" "$drain"
  if ! reload; then
    # Roll back so BIRD's on-disk state matches its running state.
    if [[ -s "$backup" ]]; then mv -f "$backup" "$STATE_FILE"; else rm -f "$STATE_FILE" "$backup"; fi
    echo "bgp-announce: rolled back to ANNOUNCE=$prev_announce DRAIN=$prev_drain" >&2
    return 1
  fi
  rm -f "$backup"
  echo "bgp-announce: ANNOUNCE=$announce DRAIN=$drain (was ANNOUNCE=$prev_announce DRAIN=$prev_drain)"
}

cmd=${1:-}
[[ $# -eq 1 ]] || usage
case "$cmd" in
  status)
    cur=$(read_state)
    announce=${cur% *}
    drain=${cur#* }
    state=withdrawn
    if [[ "$announce" == true ]]; then
      state=announced
      [[ "$drain" == true ]] && state=draining
    fi
    echo "state: $state (ANNOUNCE=$announce DRAIN=$drain) file: $STATE_FILE"
    if [[ "${BGP_NO_RELOAD:-0}" != "1" ]] && command -v "$BIRDC" >/dev/null 2>&1; then
      "$BIRDC" show protocols 2>/dev/null | awk 'NR==1 || /bgp|BGP/' || true
      for p in $("$BIRDC" show protocols 2>/dev/null | awk '$2=="BGP"{print $1}'); do
        n=$("$BIRDC" show route export "$p" count 2>/dev/null | sed -n 's/^\([0-9]*\) of .*/\1/p')
        echo "exported via $p: ${n:-?} route(s)"
      done
    fi
    ;;
  announce) set_state true false ;;
  withdraw) set_state false false ;;
  drain)
    cur=$(read_state)
    if [[ "${cur% *}" != true ]]; then
      echo "bgp-announce: not announcing; drain has no effect (use announce first)" >&2
      exit 1
    fi
    set_state true true
    ;;
  undrain)
    cur=$(read_state)
    if [[ "${cur% *}" != true ]]; then
      echo "bgp-announce: not announcing; nothing to undrain" >&2
      exit 1
    fi
    set_state true false
    ;;
  *) usage ;;
esac
