# forge node configuration. Rendered by modules/forge-node from
# infra/cloud-init/forge.toml.tftpl; scripts/deploy refreshes it.
# Every key is documented in internal/config/config.go.
node      = "${node}"
hostname  = "${service_hostname}"
title     = "${title}"
data_dir  = "/var/lib/forge"
log_level = "info"
log_format = "json"

[gemini]
# Wildcard listeners cover the anycast addresses on dummy0 and the provider
# unicast addresses, so the node answers before BGP converges. nftables
# decides which addresses/interfaces may reach the port.
listen    = ${gemini_listen}
# Secrets are decrypted into tmpfs by forge-secrets.service at boot (never on
# the root filesystem, docs/secrets.md).
cert_file = "/run/forge/secrets/tls/server.crt"
key_file  = "/run/forge/secrets/tls/server.key"
port      = 1965

[ssh]
listen        = ${ssh_listen}
# Shared across every POP (anycast); published as SSHFP by modules/cloudflare-dns.
host_key_file = "/run/forge/secrets/ssh/host_ed25519"
port          = 22
user          = "git"

[metrics]
# Private: WireGuard address (or loopback on a single node); nftables only
# admits it from wg0.
listen = "${metrics_listen}"

[cluster]
enabled        = ${cluster_enabled}
control_listen = "${control_listen}"
secret_file    = "/run/forge/secrets/cluster.secret"
sync_interval  = "10s"
# peers are appended by scripts/deploy from infra/network/address-plan.yaml:
# [cluster.peers]
# fra1 = "[fd00:...::2]:9200"
