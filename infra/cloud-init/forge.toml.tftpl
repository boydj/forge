# forge node configuration. Rendered by modules/forge-node from
# infra/cloud-init/forge.toml.tftpl; scripts/deploy refreshes it.
# Every key is documented in internal/config/config.go.
node      = "${node}"
hostname  = "${service_hostname}"
title     = "${title}"
data_dir  = "/var/lib/forge"
log_level = "info"
log_format = "json"

[gemini]
# Wildcard listeners cover the anycast addresses on dummy0 and the provider
# unicast addresses, so the node answers before BGP converges. nftables
# decides which addresses/interfaces may reach the port.
listen    = ${gemini_listen}
# Secrets are decrypted into tmpfs by forge-secrets.service at boot (never on
# the root filesystem, docs/secrets.md).
cert_file = "/run/forge/secrets/tls/server.crt"
key_file  = "/run/forge/secrets/tls/server.key"
port      = 1965

[ssh]
listen        = ${ssh_listen}
# Shared across every POP (anycast); published as SSHFP by modules/cloudflare-dns.
host_key_file = "/run/forge/secrets/ssh/host_ed25519"
port          = 22
user          = "git"

[metrics]
# Private: WireGuard address (or loopback on a single node); nftables only
# admits it from wg0.
listen = "${metrics_listen}"

[health]
# Anycast announcement control (docs/health.md). Empty = checks only, never
# announce; set by the bgp_announce variable of modules/forge-node. The
# request script hands the verb to the root-side forge-bgp.service.
announcer     = "${announcer}"
interval      = "10s"

[docs]
# The documentation site at /docs/: the docs/site/ directory (the user guide) of a public
# repository hosted on this forge, rendered at its default branch. Publishing
# is a git push to that repository (docs/dogfooding.md). Empty = no /docs/.
repo = "${docs_repo}"
path = "docs/site"

[status]
# The monitoring host's Prometheus over WireGuard (docs/monitoring.md); its
# firing alerts become the /status/alerts gemfeed. Empty = no alerts feed.
prometheus_url = "${prometheus_url}"
# Where forge-backup.service writes archives; the newest one's age is
# forge_backup_age_seconds (BackupStale after 36 h).
backup_dir = "/var/backups/forge"

[mirror]
# Outbound mirroring to an external remote (docs/dogfooding.md). The deploy
# key comes from the bundle (mirror_deploy_key -> /run/forge/secrets/mirror.key);
# without it mirroring is disabled with one log line. Host keys are pinned.
key_file         = "/run/forge/secrets/mirror.key"
known_hosts_file = "/etc/forge/mirror_known_hosts"
interval         = "1h"
${mirrors_toml}
[cluster]
enabled         = ${cluster_enabled}
control_listen  = "${control_listen}"
secret_file     = "/run/forge/secrets/cluster.secret"
sync_interval   = "10s"
metadata_leader = "${metadata_leader}"
# Peers (name = control address over WireGuard), from the environment's pops map.
[cluster.peers]
${cluster_peers_toml}
