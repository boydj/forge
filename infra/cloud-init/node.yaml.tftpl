#cloud-config
# forge node bootstrap for Debian 13 (trixie). Rendered by modules/forge-node
# (templatefile) and passed as user_data to any provider module. It creates
# users, installs packages from Debian only (nothing is fetched from GitHub or
# elsewhere: the forge binary and generated configs are pushed later by
# scripts/deploy over SSH), moves OpenSSH to port ${admin_ssh_port}, writes
# the node config and firewall, and enables the units. Files owned by the
# forge user are chown'ed in runcmd because write_files runs before users are
# created; files that packages also ship use `defer: true` so they are
# written after apt has installed the package (dpkg conffile ordering).
# Root-executed code (systemd units, forge-deploy-helper, bgp-announce,
# forge-backup) is only ever installed here or by `scripts/deploy sysupdate`
# as root: the `deploy` user's sudo is limited to forge-deploy-helper, which
# accepts data files only (SR-19a). The helper and forge-secrets.service are
# embedded inline (modules/forge-node passes a fixed variable set); the test
# suite checks they match infra/systemd/ byte for byte.
hostname: ${node}
fqdn: ${hostname_fqdn}
prefer_fqdn_over_hostname: true
manage_etc_hosts: true
timezone: Etc/UTC
locale: C.UTF-8

package_update: true
package_upgrade: true
package_reboot_if_required: false
packages:
  - git
  - bird2                       # BGP to the provider; config pushed by scripts/deploy
  - wireguard-tools             # wg-quick@wg0; config pushed by scripts/deploy
  - nftables
  - curl
  - ca-certificates
  - age                         # node secret key; decrypts what scripts/deploy ships
  - zstd
  - unattended-upgrades
  - prometheus-node-exporter    # listens on :9101 (forge metrics own :9100), wg0-only via nftables
  - sqlite3

# OpenSSH: no passwords anywhere. root keeps the provider-injected bootstrap
# key (prohibit-password); `deploy` is what scripts/deploy logs in as.
ssh_pwauth: false
disable_root: false
ssh_deletekeys: true
ssh_genkeytypes: [ed25519]
users:
  - name: forge
    system: true
    homedir: /var/lib/forge
    no_create_home: false
    shell: /usr/sbin/nologin
    lock_passwd: true
  - name: deploy
    gecos: forge deploy user
    shell: /bin/bash
    groups: [forge]
    lock_passwd: true
    # Key-only login on port ${admin_ssh_port}. Root only through the helper
    # (data files in, fixed systemctl/nft/bird/wg actions out); anything
    # else (unit updates, ad hoc debugging) is done as root@ with the
    # bootstrap key. See infra/systemd/forge-deploy-helper.
    sudo: ["ALL=(root) NOPASSWD: /usr/local/sbin/forge-deploy-helper *"]
    ssh_authorized_keys:
${operator_ssh_authorized_keys}

write_files:
  # --- OpenSSH on the admin port; forge takes 22 for Git.
  - path: /etc/ssh/sshd_config.d/10-forge.conf
    permissions: "0644"
    content: |
      Port ${admin_ssh_port}
      AddressFamily any
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      ChallengeResponseAuthentication no
      PermitRootLogin prohibit-password
      PubkeyAuthentication yes
      AllowUsers root deploy
      X11Forwarding no
      AllowAgentForwarding no
      AllowTcpForwarding no
      ClientAliveInterval 60
      ClientAliveCountMax 3
      LoginGraceTime 20
      MaxAuthTries 4

  # --- Anycast / BYOIP service addresses on a dummy interface, via
  # systemd-networkd. Only dummy0 has a .network file, so networkd leaves the
  # provider NIC to whatever the image uses (Vultr Debian images: ifupdown or
  # netplan; VERIFY on first boot with `networkctl`). If the image already runs
  # networkd these files simply join it.
  - path: /etc/systemd/network/10-anycast.netdev
    permissions: "0644"
    content: |
      [NetDev]
      Name=dummy0
      Kind=dummy
  - path: /etc/systemd/network/10-anycast.network
    permissions: "0644"
    content: |
      [Match]
      Name=dummy0
      [Network]
      ${indent(6, anycast_network_addresses)}
      [Link]
      RequiredForOnline=no

  - path: /etc/sysctl.d/60-forge.conf
    permissions: "0644"
    content: |
      net.ipv4.ip_nonlocal_bind = 1
      net.ipv6.ip_nonlocal_bind = 1
      net.ipv4.ip_forward = 0
      net.ipv6.conf.all.forwarding = 0
      net.ipv6.conf.all.accept_ra = 2
      net.ipv6.conf.default.accept_ra = 2
      net.core.somaxconn = 1024
      net.ipv4.tcp_syncookies = 1

  # --- forge
  - path: /etc/forge/forge.toml
    permissions: "0640"
    content: |
      ${indent(6, forge_toml)}
  - path: /etc/systemd/system/forge.service
    permissions: "0644"
    content: |
      ${indent(6, forge_service)}
  - path: /etc/systemd/system/forge-maintenance.service
    permissions: "0644"
    content: |
      ${indent(6, forge_maintenance_service)}
  - path: /etc/systemd/system/forge-maintenance.timer
    permissions: "0644"
    content: |
      ${indent(6, forge_maintenance_timer)}
  - path: /etc/systemd/system/forge-backup.service
    permissions: "0644"
    content: |
      ${indent(6, forge_backup_service)}
  - path: /etc/systemd/system/forge-backup.timer
    permissions: "0644"
    content: |
      ${indent(6, forge_backup_timer)}
  - path: /usr/local/bin/forge-backup
    permissions: "0755"
    content: |
      ${indent(6, forge_backup_script)}

  # --- Secrets in tmpfs (SR-02) and the deploy user's only root command
  # (SR-19a). Both are inline copies of infra/systemd/forge-secrets.service
  # and infra/systemd/forge-deploy-helper (tests/infra keeps them in sync).
  - path: /etc/systemd/system/forge-secrets.service
    permissions: "0644"
    content: |
      # forge-secrets: decrypt the node's secret bundle into tmpfs at boot (SR-02).
      # scripts/deploy leaves only /etc/forge/secrets.tar.age (age-encrypted to the
      # node's key) and /etc/forge/age.key on the root filesystem. This unit runs
      # `forge-deploy-helper load-secrets`, which puts the TLS key, SSH host key,
      # cluster secret and backup recipient under /run/forge/secrets (0700 forge)
      # and renders /run/forge/wg0.conf and /run/forge/bird.conf from the
      # placeholder templates /etc/wireguard/wg0.conf.in and /etc/bird/bird.conf.in;
      # /etc/wireguard/wg0.conf and /etc/bird/bird.conf are symlinks to those.
      # Installed by cloud-init; refreshed by `scripts/deploy sysupdate`.
      [Unit]
      Description=forge secrets (decrypt into tmpfs)
      Documentation=file:/usr/local/sbin/forge-deploy-helper
      DefaultDependencies=yes
      Before=forge.service bird.service wg-quick@wg0.service forge-backup.service
      ConditionPathExists=/usr/local/sbin/forge-deploy-helper

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      User=root
      ExecStart=/usr/local/sbin/forge-deploy-helper load-secrets
      # /run/forge is created here and kept across restarts of this unit so the
      # rendered configs stay in place while forge, bird and wg0 run. No other
      # unit may declare RuntimeDirectory=forge: systemd would chown it (recursively)
      # to that unit's user, exposing the root-only WireGuard key and BGP password.
      RuntimeDirectory=forge
      RuntimeDirectoryMode=0755
      RuntimeDirectoryPreserve=yes
      UMask=0077
      ProtectHome=yes
      PrivateTmp=yes
      PrivateDevices=yes
      ProtectKernelTunables=yes
      ProtectKernelModules=yes
      ProtectControlGroups=yes
      RestrictAddressFamilies=AF_UNIX
      RestrictNamespaces=yes
      LockPersonality=yes
      SystemCallArchitectures=native

      [Install]
      WantedBy=multi-user.target
  - path: /usr/local/sbin/forge-deploy-helper
    permissions: "0755"
    content: |
      #!/bin/bash
      # forge-deploy-helper: the one command the `deploy` user may run as root
      # (sudoers: `deploy ALL=(root) NOPASSWD: /usr/local/sbin/forge-deploy-helper *`).
      # scripts/deploy feeds it files on stdin and asks it to apply them;
      # forge-secrets.service runs `load-secrets` at boot. Source of truth is
      # infra/systemd/forge-deploy-helper: installed by cloud-init and `deploy
      # bootstrap`, refreshed only by `deploy sysupdate` (root), never by `deploy`
      # itself, so a stolen deploy key cannot replace root-executed code.
      #
      #   install-binary <sha256>   stdin -> /usr/local/bin/forge (previous kept as forge.prev)
      #   write-config <name>       stdin -> forge.toml | nftables.conf | bird.conf | state.conf | wg0.conf | secrets
      #   load-secrets              decrypt /etc/forge/secrets.tar.age into /run/forge (tmpfs); render wg0/bird configs
      #   apply                     nftables, forge-secrets, wg0, bird, forge; on failure print the journal, exit 1
      #   rollback                  forge.prev -> forge, restart
      #   drain | undrain           bgp-announce withdraw | announce
      #   init-node [rotate]        ensure /etc/forge/age.key, print the recipient
      #   status                    unit states, wg0 peers, bird protocols, last forge log lines
      # No dollar-brace expansions in this file: it is embedded verbatim in a templatefile().
      set -euo pipefail
      umask 077
      export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
      RUN=/run/forge
      BUNDLE=/etc/forge/secrets.tar.age
      KEY=/etc/forge/age.key
      PH='__[A-Z0-9_]*__'

      die() { echo "forge-deploy-helper: $*" >&2; exit 1; }
      [ "$(id -u)" = 0 ] || die "must run as root (sudo)"

      sub() { # sub <file> <placeholder> <value>: literal replace; values travel in env so any byte is safe
        grep -q "$2" "$1" || return 0
        V="$3" P="$2" perl -pi -e 's/\Q$ENV{P}\E/$ENV{V}/g' "$1"
      }
      slurp() { # slurp <path>: stdin -> temp file beside <path>; prints the temp path
        local tmp; tmp=$(mktemp "$1.XXXXXX"); cat > "$tmp"
        [ -s "$tmp" ] || { rm -f "$tmp"; die "empty input for $1"; }
        echo "$tmp"
      }
      # name -> path mode group. Data only: nothing here is executed as root.
      spec() {
        case "$1" in
          forge.toml)    echo /etc/forge/forge.toml 0640 forge;;
          nftables.conf) echo /etc/nftables.conf 0755 root;;
          bird.conf)     echo /etc/bird/bird.conf.in 0640 bird;;
          state.conf)    echo /etc/bird/state.conf 0640 bird;;
          wg0.conf)      echo /etc/wireguard/wg0.conf.in 0600 root;;
          secrets)       echo "$BUNDLE" 0600 root;;
          *) die "write-config: unknown name '$1' (forge.toml nftables.conf bird.conf state.conf wg0.conf secrets)";;
        esac
      }
      check() { # check <name> <tmp>: non-zero (and a reason) for anything malformed or that would run as root
        case "$1" in
          nftables.conf) nft -c -f "$2";;
          secrets) [ "$(head -c 21 "$2")" = "age-encryption.org/v1" ] || { echo "secrets: not an age file" >&2; return 1; };;
          wg0.conf) # wg-quick runs Pre*/Post* hooks as root: allow only the one line netgen emits
            if grep -Ei '^[[:space:]]*(Pre|Post)(Up|Down)|^[[:space:]]*SaveConfig' "$2" | grep -qvx 'PostUp = sysctl -q -w net.ipv6.conf.all.forwarding=1'; then
              echo "wg0.conf: unexpected hook line" >&2; return 1
            fi;;
          bird.conf) # provider addresses are not secret: fill them now, from the default-route source addresses
            local v4 v6
            v4=$(ip -4 route get 1.1.1.1 2> /dev/null | sed -n 's/.*src \([0-9.]*\).*/\1/p' | head -1)
            v6=$(ip -6 route get 2001:4860:4860::8888 2> /dev/null | sed -n 's/.*src \([0-9a-f:]*\).*/\1/p' | head -1)
            [ -n "$v4" ] && sub "$2" __PROVIDER_IPV4__ "$v4"
            [ -n "$v6" ] && sub "$2" __PROVIDER_IPV6__ "$v6"
            true;;
        esac
      }

      cmd_write_config() {
        [ $# -eq 1 ] || die "usage: write-config <name>"
        local s path mode group tmp; s=$(spec "$1") || exit 1; read -r path mode group <<< "$s"
        if [ "$1" = state.conf ] && grep -qs DRAIN "$path"; then cat > /dev/null; echo "state.conf: keeping live announce state"; return 0; fi
        mkdir -p "$(dirname "$path")"; tmp=$(slurp "$path")
        check "$1" "$tmp" || { rm -f "$tmp"; die "$1 rejected"; }
        chown "root:$group" "$tmp"; chmod "$mode" "$tmp"; mv -f "$tmp" "$path"; echo "wrote $path"
      }

      cmd_install_binary() {
        if [ $# -ne 1 ] || [ "$(printf '%s' "$1" | tr -dc 0-9a-f | wc -c)" != 64 ]; then die "usage: install-binary <sha256>"; fi
        local tmp; tmp=$(slurp /usr/local/bin/forge)
        echo "$1  $tmp" | sha256sum -c --quiet - || { rm -f "$tmp"; die "checksum mismatch"; }
        [ "$(head -c 4 "$tmp" | tr -d '\177')" = ELF ] || { rm -f "$tmp"; die "not an ELF binary"; }
        chown root:root "$tmp"; chmod 0755 "$tmp"
        [ -e /usr/local/bin/forge ] && cp -p /usr/local/bin/forge /usr/local/bin/forge.prev
        mv -f "$tmp" /usr/local/bin/forge; echo "installed /usr/local/bin/forge"
      }

      render() { # render <secret> <placeholder> <template> <out> <link> <mode> <group>
        [ -f "$3" ] || return 0
        local tmp="$4.tmp"; cp "$3" "$tmp"
        [ -s "$1" ] && sub "$tmp" "$2" "$(cat "$1")"
        if grep -q "$PH" "$tmp"; then
          echo "warning: $3 still has placeholders ($(grep -o "$PH" "$tmp" | sort -u | tr '\n' ' ')); $5 not activated" >&2
          rm -f "$tmp" "$4"; return 0
        fi
        chown "root:$7" "$tmp"; chmod "$6" "$tmp"; mv -f "$tmp" "$4"; ln -sfn "$4" "$5"
      }
      cmd_load_secrets() {
        local stage="$RUN/.stage" new="$RUN/.secrets.new" sec="$RUN/secrets" ids f
        mkdir -p "$RUN"; rm -rf "$stage" "$new"; install -d -m 0700 "$stage"
        if [ -s "$BUNDLE" ]; then
          [ -s "$KEY" ] || die "no $KEY"
          ids="-i $KEY"; [ -s "$KEY.old" ] && ids="$ids -i $KEY.old"   # during a key rotation either may decrypt
          # shellcheck disable=SC2086
          age -d $ids "$BUNDLE" | tar -x -C "$stage"
        else
          echo "no $BUNDLE yet (run scripts/deploy); nothing to decrypt" >&2
        fi
        install -d -m 0700 -o forge -g forge "$new" "$new/tls" "$new/ssh"
        for f in tls/server.key tls/server.crt ssh/host_ed25519 cluster.secret backup.recipient; do
          [ -f "$stage/$f" ] && install -m 0400 -o forge -g forge "$stage/$f" "$new/$f"
        done
        rm -rf "$sec.old"; [ -d "$sec" ] && mv "$sec" "$sec.old"; mv "$new" "$sec"; rm -rf "$sec.old"
        render "$stage/wg.key" __WG_PRIVATE_KEY__ /etc/wireguard/wg0.conf.in "$RUN/wg0.conf" /etc/wireguard/wg0.conf 0600 root
        render "$stage/bgp.password" __BGP_MD5__ /etc/bird/bird.conf.in "$RUN/bird.conf" /etc/bird/bird.conf 0640 bird
        rm -rf "$stage"
        rm -rf /etc/forge/secrets   # pre-tmpfs layout: never leave plaintext on the root filesystem
      }

      cmd_apply() {
        systemctl daemon-reload
        if [ -s /etc/nftables.conf ]; then nft -c -f /etc/nftables.conf && systemctl reload-or-restart nftables; fi
        systemctl restart forge-secrets.service || { journalctl -u forge-secrets -n 20 --no-pager; die "forge-secrets failed"; }
        [ -s "$RUN/wg0.conf" ] && systemctl restart wg-quick@wg0
        if [ -s "$RUN/bird.conf" ]; then bird -p -c /etc/bird/bird.conf && { birdc configure > /dev/null || systemctl restart bird; }; fi
        systemctl restart forge; sleep 2
        systemctl is-active forge > /dev/null || { journalctl -u forge -n 30 --no-pager; die "forge is not active"; }
        if [ -s "$KEY.old" ] && age -d -i "$KEY" "$BUNDLE" > /dev/null 2>&1; then rm -f "$KEY.old"; echo "age key rotation complete; removed $KEY.old"; fi
        echo "applied"
      }
      cmd_rollback() {
        [ -x /usr/local/bin/forge.prev ] || die "no /usr/local/bin/forge.prev"
        mv -f /usr/local/bin/forge /usr/local/bin/forge.failed; mv -f /usr/local/bin/forge.prev /usr/local/bin/forge
        systemctl restart forge; echo "rolled back"
      }
      cmd_init_node() {
        local rotate=""; [ $# -ge 1 ] && rotate=$1
        case "$rotate" in ""|rotate) ;; *) die "usage: init-node [rotate]";; esac
        mkdir -p /etc/forge
        if [ "$rotate" = rotate ] && [ -s "$KEY" ]; then mv -f "$KEY" "$KEY.old"; fi
        [ -s "$KEY" ] || age-keygen -o "$KEY" 2> /dev/null
        chmod 0600 "$KEY"; age-keygen -y "$KEY" > /etc/forge/age.pub; chmod 0644 /etc/forge/age.pub; cat /etc/forge/age.pub
      }
      cmd_status() {
        local u; for u in forge forge-secrets bird wg-quick@wg0 nftables forge-backup.timer forge-maintenance.timer; do
          printf '%-24s %s\n' "$u" "$(systemctl is-active "$u" 2> /dev/null || true)"; done
        if command -v wg > /dev/null; then wg show wg0 2> /dev/null | grep -E '^peer|handshake' || true; fi
        if command -v birdc > /dev/null; then birdc show protocols 2> /dev/null || true; fi
        journalctl -u forge -n 20 --no-pager || true
      }

      [ $# -ge 1 ] || die "usage: forge-deploy-helper <verb> [args]"
      verb=$1; shift
      case "$verb" in
        install-binary) cmd_install_binary "$@";;
        write-config)   cmd_write_config "$@";;
        load-secrets)   [ $# -eq 0 ] || die "load-secrets takes no arguments"; cmd_load_secrets;;
        apply)          [ $# -eq 0 ] || die "apply takes no arguments"; cmd_apply;;
        rollback)       [ $# -eq 0 ] || die "rollback takes no arguments"; cmd_rollback;;
        drain)          [ $# -eq 0 ] || die "drain takes no arguments"; exec /usr/local/bin/bgp-announce withdraw;;
        undrain)        [ $# -eq 0 ] || die "undrain takes no arguments"; exec /usr/local/bin/bgp-announce announce;;
        init-node)      cmd_init_node "$@";;
        status)         [ $# -eq 0 ] || die "status takes no arguments"; cmd_status;;
        *) die "unknown verb '$verb'";;
      esac

  # --- Firewall (nftables package ships a default /etc/nftables.conf: defer).
  - path: /etc/nftables.conf
    permissions: "0755"
    defer: true
    content: |
      ${indent(6, nftables_conf)}

  # --- BIRD placeholder: starts with no sessions. scripts/deploy replaces
  # bird.conf with infra/bird/generated/${node}/bird.conf; state.conf is the
  # file the forge health worker and scripts/bgp-announce toggle.
  - path: /etc/bird/bird.conf
    permissions: "0640"
    defer: true
    content: |
      # placeholder written by cloud-init; replaced by scripts/deploy
      log syslog all;
      protocol device { scan time 10; }
      include "/etc/bird/state.conf";
  - path: /etc/bird/state.conf
    permissions: "0640"
    defer: true
    content: |
      define ANNOUNCE = false;
      define DRAIN = false;

  - path: /etc/default/prometheus-node-exporter
    permissions: "0644"
    defer: true
    content: |
      ARGS="--web.listen-address=:9101 --collector.disable-defaults --collector.cpu --collector.meminfo --collector.filesystem --collector.netdev --collector.loadavg --collector.diskstats --collector.systemd"

  - path: /etc/apt/apt.conf.d/20auto-upgrades
    permissions: "0644"
    content: |
      APT::Periodic::Update-Package-Lists "1";
      APT::Periodic::Unattended-Upgrade "1";
      Unattended-Upgrade::Automatic-Reboot "false";

  - path: /etc/forge/node.env
    permissions: "0644"
    content: |
      # facts scripts/deploy and the node itself may consult
      FORGE_NODE=${node}
      FORGE_ROLE=${role}
      FORGE_POP_INDEX=${pop_index}
      FORGE_SERVICE_HOSTNAME=${service_hostname}

runcmd:
  # kernel + addresses
  - [sysctl, --system]
  - [systemctl, enable, --now, systemd-networkd]
  - [networkctl, reload]
  # forge user and directories (write_files ran before users existed)
  - [install, -d, -m, "0750", -o, forge, -g, forge, /var/lib/forge, /var/lib/forge/tls, /var/lib/forge/ssh]
  - [install, -d, -m, "0750", -o, root, -g, forge, /etc/forge]
  - [install, -d, -m, "0700", /var/backups/forge]
  - [chgrp, forge, /etc/forge/forge.toml]
  # node age identity: generated here, never leaves the machine. The public
  # half is what `scripts/deploy init-node` collects into infra/secrets/nodes/.
  # It is the one secret that must persist on disk: it is what turns the
  # shipped /etc/forge/secrets.tar.age back into keys at every boot.
  - [/usr/local/sbin/forge-deploy-helper, init-node]
  # OpenSSH to the admin port (handle socket-activated images too)
  - [sh, -c, "systemctl is-enabled ssh.socket >/dev/null 2>&1 && systemctl disable --now ssh.socket || true"]
  - [sh, -c, "sshd -t && systemctl restart ssh"]
  # firewall: check then enable
  - [sh, -c, "nft -c -f /etc/nftables.conf && systemctl enable --now nftables && nft -f /etc/nftables.conf"]
  # units: forge waits for the binary (ConditionPathExists); wg0 for its config
  - [chown, "root:bird", /etc/bird/bird.conf, /etc/bird/state.conf]
  - [systemctl, daemon-reload]
  - [systemctl, enable, --now, forge-secrets.service]
  - [systemctl, enable, forge.service, forge-maintenance.timer, forge-backup.timer, wg-quick@wg0.service]
  - [systemctl, enable, --now, bird, prometheus-node-exporter, unattended-upgrades]
  - [systemctl, start, forge-maintenance.timer, forge-backup.timer]
  # Console lines for the operator: age recipient, and the sshd host key for
  # `scripts/deploy init-node --known-hosts-line` / `--hostkey-fingerprint`
  # (read them from the provider console; SR-19b).
  - [sh, -c, "echo \"forge node ${node} (${role}, ${hostname_fqdn}) bootstrapped; admin ssh :${admin_ssh_port}; age recipient $(cat /etc/forge/age.pub)\" | tee /dev/console"]
  - [sh, -c, "echo \"known_hosts: [${hostname_fqdn}]:${admin_ssh_port} $(cut -d' ' -f1,2 /etc/ssh/ssh_host_ed25519_key.pub)\" | tee /dev/console"]
  - [sh, -c, "echo \"hostkey fingerprint: $(ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub | cut -d' ' -f2)\" | tee /dev/console"]

final_message: "forge node ${node} ready after $UPTIME s (cloud-init $VERSION); next: scripts/deploy init-node ${node} && scripts/deploy ${node}"
