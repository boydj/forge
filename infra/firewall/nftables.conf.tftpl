#!/usr/sbin/nft -f
# forge node firewall. Rendered by modules/forge-node from
# infra/firewall/nftables.conf.tftpl; installed at /etc/nftables.conf by
# cloud-init and refreshed by scripts/deploy. Input policy drop.
#
# Addresses present on a node: provider unicast (main NIC, unknown at render
# time), anycast service addresses (dummy0), WireGuard (wg0). Service ports
# are accepted on every non-wg0 interface, so they work on both the anycast
# and the provider unicast addresses (reachable before BGP converges); the
# private ports are accepted only from wg0.
flush ruleset

define ANYCAST_V4 = { ${anycast_v4} }
define ANYCAST_V6 = { ${anycast_v6} }
define ADMIN_SSH  = ${admin_ssh_port}
define WG_PORT    = ${wg_port}
define WG_IF      = "${wg_iface}"
# Public service ports: the union of the public_tcp of the services this POP
# runs (address-plan.yaml `services:`; the generated cross-check is
# pop_<name>_public_tcp in infra/network/generated/nftables-vars.nft).
define PUBLIC_TCP  = { ${public_tcp_ports} }
# Private ports reachable only over the mesh: the services' private_tcp plus
# the platform's own (node-exporter, and bird-exporter on BGP nodes).
define PRIVATE_TCP = { ${private_tcp_ports} }
# Vultr BGP peers (multihop 2; session is outbound but allow inbound too).
define BGP_PEERS_V4 = { 169.254.169.254 }
define BGP_PEERS_V6 = { 2001:19f0:ffff::1 }

table inet filter {
  # Per-source new-connection limits (dynamic sets, entries expire).
  set ssh_admin_v4 { type ipv4_addr; flags dynamic; timeout 10m; }
  set ssh_admin_v6 { type ipv6_addr; flags dynamic; timeout 10m; }
  set svc_v4       { type ipv4_addr; flags dynamic; timeout 10m; }
  set svc_v6       { type ipv6_addr; flags dynamic; timeout 10m; }

  chain input {
    type filter hook input priority filter; policy drop;

    iif "lo" accept
    ct state established,related accept
    ct state invalid drop

    # ICMP: ND/RA/MLD must never be rate-limited or v6 breaks; the rest is bounded.
    icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-solicit,
                  nd-router-advert, nd-redirect, mld-listener-query,
                  mld-listener-report, mld-listener-done, mld2-listener-report } accept
    icmpv6 type { destination-unreachable, packet-too-big, time-exceeded,
                  parameter-problem, echo-request, echo-reply } limit rate 200/second accept
    icmp type { destination-unreachable, time-exceeded, parameter-problem,
                echo-request, echo-reply } limit rate 200/second accept

    # Operator SSH (OpenSSH on ADMIN_SSH), rate-limited per source.
    tcp dport $ADMIN_SSH ct state new add @ssh_admin_v4 { ip saddr limit rate 6/minute burst 10 packets } accept
    tcp dport $ADMIN_SSH ct state new add @ssh_admin_v6 { ip6 saddr limit rate 6/minute burst 10 packets } accept

    # Public services on anycast + provider unicast addresses (anything not
    # arriving over wg0). Per-source new-connection ceiling; each service
    # applies its own per-IP limits on top.
    iifname != $WG_IF tcp dport $PUBLIC_TCP ct state new add @svc_v4 { ip saddr limit rate 60/minute burst 120 packets } accept
    iifname != $WG_IF tcp dport $PUBLIC_TCP ct state new add @svc_v6 { ip6 saddr limit rate 60/minute burst 120 packets } accept

    # WireGuard mesh (peers unknown at render time; WireGuard authenticates).
    udp dport $WG_PORT accept

    # Mesh-only ports.
    iifname $WG_IF tcp dport $PRIVATE_TCP accept

    # BGP with the provider peers (belt and braces; session is outbound).
    ip saddr $BGP_PEERS_V4 tcp dport 179 accept
    ip6 saddr $BGP_PEERS_V6 tcp dport 179 accept

    # Quiet log for everything else (bounded).
    limit rate 5/minute log prefix "nft-drop: " counter
    counter drop
  }

  chain forward {
    type filter hook forward priority filter; policy drop;
  }

  chain output {
    # Egress is open: apt, BGP to link-local peers (169.254.169.254 must stay
    # reachable), WireGuard, replication over wg0, outbound git fetches.
    type filter hook output priority filter; policy accept;
  }
}
