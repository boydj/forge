# forge: Gemini/Titan (1965) and Git-over-SSH (22) service.
# Installed by cloud-init from infra/systemd/forge.service; the binary is
# pushed by scripts/deploy. Ports below 1024 are bound with
# CAP_NET_BIND_SERVICE instead of running as root.
[Unit]
Description=forge (Gemini/Titan and Git over SSH)
Documentation=https://git.as215520.net/
After=network-online.target nftables.service
Wants=network-online.target
# wg0 carries the metrics/control listeners; if the mesh is not configured
# (single-node install) the unit still starts, since this is only a Wants.
Wants=wg-quick@wg0.service
After=wg-quick@wg0.service
# Secrets live in tmpfs: forge-secrets.service decrypts them into
# /run/forge/secrets before we start (SR-02). Hard dependency: without it
# there is no TLS key, no host key, no cluster secret.
Requires=forge-secrets.service
After=forge-secrets.service
ConditionPathExists=/etc/forge/forge.toml
ConditionPathExists=/usr/local/bin/forge

[Service]
Type=simple
User=forge
Group=forge
ExecStart=/usr/local/bin/forge serve --config /etc/forge/forge.toml
Restart=on-failure
RestartSec=2
TimeoutStopSec=30
KillMode=mixed

# Resource bounds sized for a 1 vCPU / 1 GB VPS shared with bird and sshd.
CPUQuota=90%
MemoryMax=600M
MemoryHigh=512M
TasksMax=512
LimitNOFILE=65536
OOMScoreAdjust=100

# Privileges: only bind low ports.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Filesystem: read-only everything except the data directory and its own
# state/log directories. /etc/forge/forge.toml is group-forge readable; the
# TLS key, host key and cluster secret are read from /run/forge/secrets
# (tmpfs, 0700 forge, written by forge-secrets.service). Deliberately no
# RuntimeDirectory=forge here: /run/forge belongs to forge-secrets.service and
# systemd would recursively chown it to forge (see that unit).
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/forge
StateDirectory=forge
LogsDirectory=forge
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid

# Network: TCP/Unix only; no netlink, no packet sockets.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Go's runtime does not need writable+executable mappings; safe for a static
# Go binary (it would break only with cgo JIT-style plugins, which forge has none of).
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
UMask=0027

# git subprocesses inherit all of the above; git needs HOME for its config lookup.
Environment=HOME=/var/lib/forge
Environment=GIT_CONFIG_NOSYSTEM=1

[Install]
WantedBy=multi-user.target
