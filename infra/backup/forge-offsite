#!/bin/sh
# forge-offsite FILE: copy one backup archive to object storage with rclone.
# Called by forge-backup as OFFSITE_CMD (EnvironmentFile
# /etc/default/forge-backup, rendered by modules/forge-node):
#   OFFSITE_CMD=/usr/local/bin/forge-offsite
#   OFFSITE_BUCKET=<bucket>            OFFSITE_PREFIX=<node name>
# Credentials live only in tmpfs: /run/forge/secrets/rclone.conf (a "b2"
# remote with the bucket-restricted write-only key; scripts/deploy builds it
# from the bundle; infra/backup/b2.yaml describes the bucket).
# Exit status is the backup's: a failed copy fails forge-backup.service,
# which NodeSystemdUnitFailed reports.
set -eu
file=${1:?archive}
conf=${RCLONE_CONFIG:-/run/forge/secrets/rclone.conf}
[ -s "$conf" ] || { echo "forge-offsite: no $conf (b2_backup_key_id/b2_backup_key not in the bundle?)" >&2; exit 1; }
[ -n "${OFFSITE_BUCKET:-}" ] || { echo "forge-offsite: OFFSITE_BUCKET not set" >&2; exit 1; }
dest="b2:${OFFSITE_BUCKET}/${OFFSITE_PREFIX:-$(hostname -s)}/"
# --no-check-dest: the write-only key has no readFiles, so rclone must not
# HEAD the destination before uploading (it would get 401); archives have
# unique names, so there is nothing to compare anyway.
rclone --config "$conf" --cache-dir /var/lib/forge/tmp/rclone --contimeout 30s --timeout 5m --retries 3 \
  --no-check-dest copy "$file" "$dest"
echo "forge-offsite: copied $(basename "$file") to $dest"
