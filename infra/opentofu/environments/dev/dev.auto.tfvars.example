# Copy to dev.auto.tfvars (git-ignored). Addresses come from
# infra/network/address-plan.yaml (the values below are the plan's for ewr1);
# only the SSH keys and toggles need editing.

zone_name = "as215520.net"
# zone_id  = "023e105f4ecef8ad9ca31a8372d0c353"   # optional; skips Zone:Read

anycast_v4 = ["44.32.58.1"]
anycast_v6 = ["2a0f:85c1:368:1::1"]

# Static/other nodes for <pop>.nodes.<zone>. The dev POP created below is
# merged in automatically from the instance's addresses.
nodes = {}

# ssh-keygen -r git.as215520.net -f /etc/ssh/ssh_host_ed25519_key.pub
# Only the SHA-256 (type 2) line is needed.
sshfp = [
  # { algorithm = 4, type = 2, fingerprint = "..." },
]

manage_dnssec = false
create_dns    = true

# --- POPs (addresses from infra/network/address-plan.yaml)
create_node = false # true once VULTR_API_KEY is available

bootstrap_ssh_public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExample0000000000000000000000000000000000 operator@example"
# operator_ssh_public_keys = ["ssh-ed25519 ... operator@laptop"]   # defaults to the bootstrap key

metadata_leader = "ewr1"

pops = {
  ewr1 = {
    region           = "ewr"
    index            = 1
    unicast_v6_block = "2a0f:85c1:368:101::/64" # pops[ewr1].ipv6_unicast_block
    wg_address       = "fda5:bc65:9bb1:1::1/64"  # pops[ewr1].wg_address + mesh prefix length
    role             = "leader"
    bgp_announce     = false # M7 go-live: set true, then scripts/deploy ewr1
  }
  ams1 = {
    region           = "ams"
    index            = 2
    unicast_v6_block = "2a0f:85c1:368:102::/64"
    wg_address       = "fda5:bc65:9bb1:1::2/64"
    bgp_announce     = false
  }
}
