#!/usr/bin/env python3
"""netgen: generate per-POP network configuration from infra/network/address-plan.yaml.

Outputs (all deterministic, safe to commit and diff):
  infra/bird/generated/<pop>/bird.conf      BIRD 2 configuration (POPs with the bgp role)
  infra/bird/generated/<pop>/state.conf     ANNOUNCE/DRAIN constants (initial: withdrawn)
  infra/wireguard/generated/<pop>/wg0.conf  wg-quick configuration (full mesh, every node)

A node with roles [monitor] (the Prometheus host) is a mesh member only: it
gets a wg0.conf and appears as a peer of every production POP, but has no
BIRD config, no anycast or /48 unicast addresses and no bgp-announce.
  infra/network/generated/dns-nodes.yaml    input for infra/opentofu/modules/cloudflare-dns
  infra/network/generated/nftables-vars.nft nftables `define`s for the host firewall
  infra/network/generated/summary.md        human summary of the plan

Usage:
  scripts/netgen [--plan FILE] [--overrides FILE] [--out-root DIR]
  scripts/netgen --check [--plan FILE] [--overrides FILE]

Provider-assigned addresses and WireGuard public keys come from the overrides
file (OpenTofu outputs at deploy time); missing values become __PLACEHOLDER__
tokens. Secrets are never read or written: __BGP_MD5__ and __WG_PRIVATE_KEY__
are filled from SOPS on the node.

Only the Python standard library and PyYAML are used.
"""

from __future__ import annotations

import argparse
import ipaddress
import os
import re
import shutil
import sys
from typing import Any

try:
    import yaml
except ImportError:  # pragma: no cover
    sys.exit("netgen: PyYAML is required (pip install --user pyyaml)")

REPO_ROOT = os.path.abspath(os.path.join(os.path.dirname(os.path.abspath(__file__)), os.pardir))
DEFAULT_PLAN = os.path.join(REPO_ROOT, "infra", "network", "address-plan.yaml")
FORBIDDEN_COMMUNITY = "20473:6000"  # Vultr "do not advertise globally"
HEADER = "Generated by scripts/netgen from infra/network/address-plan.yaml. DO NOT EDIT."

IPv4Net = ipaddress.IPv4Network
IPv6Net = ipaddress.IPv6Network


# ---------------------------------------------------------------------------
# Loading and merging
# ---------------------------------------------------------------------------

def load_yaml(path: str) -> dict:
    with open(path, encoding="utf-8") as fh:
        data = yaml.safe_load(fh)
    if not isinstance(data, dict):
        raise SystemExit(f"netgen: {path}: top level must be a mapping")
    return data


def merge_overrides(plan: dict, overrides: dict | None) -> dict:
    """Apply an overrides document to the plan (in place) and return it.

    Shape:
      pops: {<name>: {provider_ipv4, provider_ipv6, wg_listen_port}}
      wireguard: {public_keys: {<name>: <key>}}
    Unknown POP names or keys are errors: the overrides file must never grow
    the topology, only fill in provider-assigned values.
    """
    if not overrides:
        return plan
    allowed_pop_keys = {"provider_ipv4", "provider_ipv6", "wg_listen_port"}
    pops_by_name = {p["name"]: p for p in plan.get("pops", [])}
    for name, values in (overrides.get("pops") or {}).items():
        if name not in pops_by_name:
            raise SystemExit(f"netgen: overrides: unknown POP {name!r}")
        for key, value in (values or {}).items():
            if key not in allowed_pop_keys:
                raise SystemExit(f"netgen: overrides: pops.{name}.{key} is not overridable")
            pops_by_name[name][key] = value
    wg = plan.setdefault("wireguard", {})
    keys = wg.setdefault("public_keys", None) or {}
    for name, key in ((overrides.get("wireguard") or {}).get("public_keys") or {}).items():
        if name not in pops_by_name:
            raise SystemExit(f"netgen: overrides: public key for unknown POP {name!r}")
        keys[name] = key
    wg["public_keys"] = keys
    for key in overrides:
        if key not in {"pops", "wireguard"}:
            raise SystemExit(f"netgen: overrides: unknown top-level key {key!r}")
    return plan


# ---------------------------------------------------------------------------
# Derived model
# ---------------------------------------------------------------------------

class Pop:
    def __init__(self, raw: dict, plan: dict):
        self.raw = raw
        self.name: str = raw["name"]
        self.provider: str = raw["provider"]
        self.region: str = raw.get("region", "")
        self.index: int = int(raw["index"])
        self.roles: list[str] = list(raw.get("roles") or [])
        self.services: list[str] = list(raw.get("services") or [])
        self.catalogue: dict = plan.get("services") or {}
        self.node_private: dict = plan.get("node_private_tcp") or {}
        self.dns: bool = bool(raw.get("dns", True))
        self.provider_ipv4: str | None = raw.get("provider_ipv4")
        self.provider_ipv6: str | None = raw.get("provider_ipv6")
        self.wg_listen_port: int = int(raw.get("wg_listen_port") or plan["wireguard"]["listen_port"])
        # A monitor has no /48 unicast block (and no anycast): only a mesh address.
        self.is_monitor = "monitor" in self.roles
        block = raw.get("ipv6_unicast_block")
        self.unicast_block = ipaddress.ip_network(block) if block else None
        self.node_address = (
            self.unicast_block[int(plan["ipv6"].get("pop_node_host", 1))] if self.unicast_block is not None else None
        )
        self.wg_address = ipaddress.ip_address(raw["wg_address"])
        self.is_lab = "lab" in self.roles or self.provider == "local"
        self.upstream_name = self.provider

    @property
    def public(self) -> bool:
        return not self.is_lab

    @property
    def bgp(self) -> bool:
        """True for nodes that run BIRD and announce the prefixes."""
        return "bgp" in self.roles and not self.is_monitor

    @property
    def serves(self) -> bool:
        """True for nodes carrying the service (anycast + /48 unicast): everything but a monitor."""
        return not self.is_monitor

    @property
    def mesh_group(self) -> str:
        return "lab" if self.is_lab else "production"

    @property
    def public_tcp(self) -> list[int]:
        """Ports this POP admits from the internet: the union over its services."""
        ports: set[int] = set()
        for name in self.services:
            ports.update(self.catalogue.get(name, {}).get("public_tcp") or [])
        return sorted(ports)

    @property
    def private_tcp(self) -> list[int]:
        """Ports this POP admits on wg0: its services' plus the platform's own."""
        ports: set[int] = set(self.node_private.get("all") or [])
        if self.bgp:
            ports.update(self.node_private.get("bgp") or [])
        for name in self.services:
            ports.update(self.catalogue.get(name, {}).get("private_tcp") or [])
        return sorted(ports)

    @property
    def critical_services(self) -> list[str]:
        """Services whose failure withdraws this POP from anycast (ADR 0014)."""
        return sorted(n for n in self.services if (self.catalogue.get(n) or {}).get("critical"))

    def wg_endpoint_host(self, preference: list[str]) -> str | None:
        for pref in preference:
            value = getattr(self, pref, None)
            if value:
                return value
        return None


def build_pops(plan: dict) -> list[Pop]:
    return sorted((Pop(p, plan) for p in plan.get("pops", [])), key=lambda p: p.name)


# ---------------------------------------------------------------------------
# Validation
# ---------------------------------------------------------------------------

class Checker:
    def __init__(self) -> None:
        self.errors: list[str] = []
        self.passed = 0

    def check(self, condition: bool, message: str) -> bool:
        if condition:
            self.passed += 1
        else:
            self.errors.append(message)
        return condition


def parse_net(value: Any, strict: bool = True):
    try:
        return ipaddress.ip_network(value, strict=strict)
    except (ValueError, TypeError):
        return None


def parse_addr(value: Any):
    try:
        return ipaddress.ip_address(value)
    except (ValueError, TypeError):
        return None


def parse_ipv4_range(text: str):
    """'a.b.c.d-a.b.c.e' or 'a.b.c.d/nn' -> (first, last) or None."""
    if "-" in text:
        a, b = text.split("-", 1)
        lo, hi = parse_addr(a.strip()), parse_addr(b.strip())
        if lo is None or hi is None or lo.version != 4 or hi.version != 4 or lo > hi:
            return None
        return lo, hi
    net = parse_net(text)
    if net is None or net.version != 4:
        return None
    return net[0], net[-1]


def walk_strings(value: Any, path: str = ""):
    if isinstance(value, dict):
        for k, v in value.items():
            yield from walk_strings(v, f"{path}.{k}" if path else str(k))
    elif isinstance(value, list):
        for i, v in enumerate(value):
            yield from walk_strings(v, f"{path}[{i}]")
    elif isinstance(value, str):
        yield path, value


def validate(plan: dict) -> Checker:
    c = Checker()

    # ---- top level -------------------------------------------------------
    for key in ("ipv6", "ipv4", "wireguard", "pops", "bgp", "rpki", "irr", "zone"):
        c.check(key in plan, f"missing top-level key {key!r}")
    if c.errors:
        return c

    # ---- IPv6 ------------------------------------------------------------
    v6 = plan["ipv6"]
    p6 = parse_net(v6.get("prefix"))
    c.check(p6 is not None and p6.version == 6 and p6.prefixlen == 48, "ipv6.prefix must be a valid IPv6 /48")
    regions = []
    for r in v6.get("regions", []):
        net = parse_net(r.get("prefix"))
        if not c.check(net is not None and net.version == 6, f"ipv6.regions: invalid prefix {r.get('prefix')!r}"):
            continue
        c.check(p6 is not None and net.subnet_of(p6), f"ipv6.regions: {net} is outside {p6}")
        regions.append(net)
    for i, a in enumerate(regions):
        for b in regions[i + 1:]:
            c.check(not a.overlaps(b), f"ipv6.regions: {a} overlaps {b}")
    subnets = []
    for s in v6.get("subnets", []):
        net = parse_net(s.get("prefix"))
        if not c.check(net is not None and net.version == 6 and net.prefixlen == 64,
                       f"ipv6.subnets: {s.get('prefix')!r} must be a valid IPv6 /64"):
            continue
        c.check(sum(1 for r in regions if net.subnet_of(r)) == 1, f"ipv6.subnets: {net} is not inside exactly one region")
        subnets.append(net)
    for i, a in enumerate(subnets):
        for b in subnets[i + 1:]:
            c.check(not a.overlaps(b), f"ipv6.subnets: {a} overlaps {b}")
    anycast6 = next((parse_net(s["prefix"]) for s in v6.get("subnets", []) if s.get("purpose") == "anycast-services"), None)
    c.check(anycast6 is not None, "ipv6.subnets: no subnet with purpose anycast-services")
    service_addrs6 = []
    for svc in v6.get("services", []):
        addr = parse_addr(svc.get("address"))
        if not c.check(addr is not None and addr.version == 6, f"ipv6.services: invalid address {svc.get('address')!r}"):
            continue
        c.check(anycast6 is not None and addr in anycast6, f"ipv6.services: {addr} is not inside the anycast-services /64")
        c.check(addr not in service_addrs6, f"ipv6.services: duplicate address {addr}")
        service_addrs6.append(addr)
    c.check("{index:02x}" in v6.get("pop_unicast_template", ""), "ipv6.pop_unicast_template must contain {index:02x}")
    unicast_region = next((parse_net(r["prefix"]) for r in v6.get("regions", []) if r.get("purpose") == "pop-unicast"), None)
    c.check(unicast_region is not None, "ipv6.regions: no region with purpose pop-unicast")

    # ---- IPv4 ------------------------------------------------------------
    v4 = plan["ipv4"]
    p4 = parse_net(v4.get("prefix"))
    c.check(p4 is not None and p4.version == 4 and p4.prefixlen == 24, "ipv4.prefix must be a valid IPv4 /24")
    service_addrs4 = []
    for svc in v4.get("services", []):
        addr = parse_addr(svc.get("address"))
        if not c.check(addr is not None and addr.version == 4, f"ipv4.services: invalid address {svc.get('address')!r}"):
            continue
        c.check(p4 is not None and addr in p4, f"ipv4.services: {addr} is outside {p4}")
        c.check(addr not in service_addrs4, f"ipv4.services: duplicate address {addr}")
        service_addrs4.append(addr)
    ranges = []
    for r in v4.get("reserved", []):
        rng = parse_ipv4_range(str(r.get("range")))
        if not c.check(rng is not None, f"ipv4.reserved: invalid range {r.get('range')!r}"):
            continue
        c.check(p4 is not None and rng[0] in p4 and rng[1] in p4, f"ipv4.reserved: {r['range']} is outside {p4}")
        for a in service_addrs4:
            c.check(not (rng[0] <= a <= rng[1]), f"ipv4.reserved: {r['range']} overlaps service address {a}")
        for other in ranges:
            c.check(rng[1] < other[0] or rng[0] > other[1], f"ipv4.reserved: {r['range']} overlaps another reserved range")
        ranges.append(rng)

    # ---- service catalogue ------------------------------------------------
    catalogue = plan.get("services")
    c.check(isinstance(catalogue, dict) and bool(catalogue), "services: must be a non-empty mapping of service name -> definition")
    catalogue = catalogue if isinstance(catalogue, dict) else {}
    for sname, svc in catalogue.items():
        if not c.check(isinstance(svc, dict), f"services.{sname}: must be a mapping"):
            continue
        c.check(isinstance(svc.get("description"), str) and svc["description"].strip(),
                f"services.{sname}: description must be a non-empty string")
        for field in ("critical", "anycast"):
            c.check(isinstance(svc.get(field), bool), f"services.{sname}: {field} must be true or false")
        seen_ports: dict[int, str] = {}
        for field in ("public_tcp", "private_tcp"):
            ports = svc.get(field)
            if not c.check(isinstance(ports, list), f"services.{sname}: {field} must be a list"):
                continue
            for port in ports:
                if not c.check(isinstance(port, int) and 1 <= port <= 65535,
                               f"services.{sname}.{field}: {port!r} must be an integer 1..65535"):
                    continue
                c.check(port not in seen_ports,
                        f"services.{sname}: port {port} is both {seen_ports.get(port)} and {field}")
                seen_ports[port] = field
        # An anycast service must actually have an address to answer on.
        if svc.get("anycast"):
            has_addr = any(s.get("name") == sname for fam in ("ipv6", "ipv4") for s in plan[fam].get("services", []))
            c.check(has_addr, f"services.{sname}: anycast is true but no ipv6.services/ipv4.services entry is named {sname}")
    # Address assignments cross-check: an entry naming a catalogue service may
    # only bind that service's public ports; anything else is a reservation.
    for fam in ("ipv6", "ipv4"):
        for s in plan[fam].get("services", []):
            sname, ports = s.get("name"), (s.get("ports") or [])
            if sname in catalogue:
                allowed = set(catalogue[sname].get("public_tcp") or [])
                extra = sorted(set(ports) - allowed)
                c.check(not extra, f"{fam}.services.{sname}: port(s) {extra} are not in services.{sname}.public_tcp")
            else:
                c.check(not ports, f"{fam}.services.{sname}: not in the service catalogue, so it is a reservation and must have ports: []")
    npt = plan.get("node_private_tcp") or {}
    c.check(isinstance(npt, dict), "node_private_tcp must be a mapping of role -> port list")
    for role, ports in (npt.items() if isinstance(npt, dict) else []):
        c.check(isinstance(ports, list) and all(isinstance(p, int) and 1 <= p <= 65535 for p in ports),
                f"node_private_tcp.{role}: must be a list of integers 1..65535")

    # ---- WireGuard -------------------------------------------------------
    wg = plan["wireguard"]
    ula = parse_net(wg.get("ula_prefix"))
    mesh = parse_net(wg.get("mesh_prefix"))
    c.check(ula is not None and ula.version == 6 and ula.prefixlen == 48 and ula.subnet_of(ipaddress.ip_network("fd00::/8")),
            "wireguard.ula_prefix must be an RFC 4193 fd00::/8 /48")
    c.check(mesh is not None and mesh.version == 6 and mesh.prefixlen == 64 and ula is not None and mesh.subnet_of(ula),
            "wireguard.mesh_prefix must be a /64 inside ula_prefix")
    c.check(p6 is None or ula is None or not ula.overlaps(p6), "wireguard.ula_prefix overlaps the public /48")
    c.check("{index:x}" in wg.get("node_address_template", ""), "wireguard.node_address_template must contain {index:x}")
    port = wg.get("listen_port")
    c.check(isinstance(port, int) and 1 <= port <= 65535, "wireguard.listen_port must be 1..65535")
    c.check(isinstance(wg.get("mtu"), int) and 1280 <= wg["mtu"] <= 1500, "wireguard.mtu must be 1280..1500")
    for pref in wg.get("endpoint_preference", []):
        c.check(pref in ("provider_ipv4", "provider_ipv6"), f"wireguard.endpoint_preference: unknown {pref!r}")

    # ---- POPs ------------------------------------------------------------
    names: set[str] = set()
    indices: set[int] = set()
    blocks: list = []
    wg_addrs: set = set()
    upstreams = plan["bgp"].get("upstreams", {})
    for raw in plan.get("pops", []):
        name = raw.get("name")
        if not c.check(isinstance(name, str) and re.fullmatch(r"[a-z0-9]([a-z0-9-]*[a-z0-9])?", name or ""),
                       f"pops: invalid name {name!r} (must be a DNS label)"):
            continue
        c.check(name not in names, f"pops: duplicate name {name}")
        names.add(name)
        idx = raw.get("index")
        if not c.check(isinstance(idx, int) and 1 <= idx <= 255, f"pops.{name}: index must be an integer 1..255"):
            continue
        c.check(idx not in indices, f"pops.{name}: duplicate index {idx}")
        indices.add(idx)
        roles = raw.get("roles")
        c.check(isinstance(roles, list) and bool(roles), f"pops.{name}: roles must be a non-empty list")
        is_monitor = isinstance(roles, list) and "monitor" in roles
        # Services come from the catalogue by name; a service name in `roles`
        # is the pre-catalogue shape and is rejected so the two cannot drift.
        svc_names = raw.get("services", [])
        if c.check(isinstance(svc_names, list), f"pops.{name}: services must be a list of catalogue names"):
            for sname in svc_names:
                c.check(sname in catalogue, f"pops.{name}: unknown service {sname!r} (not in the services catalogue)")
            dupes = sorted({s for s in svc_names if svc_names.count(s) > 1})
            c.check(not dupes, f"pops.{name}: duplicate service(s) {dupes}")
            # Two services on one POP must not want the same port.
            for field in ("public_tcp", "private_tcp"):
                owner: dict[int, str] = {}
                for sname in svc_names:
                    for port in (catalogue.get(sname, {}).get(field) or []):
                        c.check(port not in owner,
                                f"pops.{name}: services {owner.get(port)} and {sname} both claim {field} port {port}")
                        owner.setdefault(port, sname)
            for sname in svc_names:
                if (catalogue.get(sname) or {}).get("anycast"):
                    c.check(not is_monitor,
                            f"pops.{name}: service {sname} is anycast but a monitor carries no anycast addresses")
        for sname in (svc_names if isinstance(svc_names, list) else []):
            c.check(sname not in (roles or []), f"pops.{name}: {sname!r} is a service, not a role; list it only under services")
        for role in (roles or []):
            c.check(role not in catalogue, f"pops.{name}: {role!r} is a service, not a role; move it to services")
        if is_monitor:
            # The monitor is a mesh member only: no service addresses, no BGP.
            c.check(roles == ["monitor"], f"pops.{name}: the monitor role is exclusive (no bgp/replica/lab)")
            c.check(not svc_names, f"pops.{name}: a monitor runs no services")
            c.check(raw.get("ipv6_unicast_block") in (None, ""),
                    f"pops.{name}: a monitor has no ipv6_unicast_block (no anycast, no /48 unicast)")
        else:
            c.check(raw.get("provider") in upstreams, f"pops.{name}: provider {raw.get('provider')!r} has no bgp.upstreams entry")
            block = parse_net(raw.get("ipv6_unicast_block"))
            expected = parse_net(v6["pop_unicast_template"].format(index=idx))
            if c.check(block is not None and block.version == 6 and block.prefixlen == 64,
                       f"pops.{name}: ipv6_unicast_block must be a valid IPv6 /64"):
                c.check(block == expected, f"pops.{name}: ipv6_unicast_block {block} != derived {expected}")
                c.check(unicast_region is not None and block.subnet_of(unicast_region),
                        f"pops.{name}: ipv6_unicast_block {block} is outside the pop-unicast region")
                for other in blocks:
                    c.check(not block.overlaps(other), f"pops.{name}: ipv6_unicast_block {block} overlaps {other}")
                for s in subnets:
                    c.check(not block.overlaps(s), f"pops.{name}: ipv6_unicast_block {block} overlaps subnet {s}")
                blocks.append(block)
        wga = parse_addr(raw.get("wg_address"))
        expected_wg = parse_addr(wg["node_address_template"].format(index=idx))
        if c.check(wga is not None and wga.version == 6, f"pops.{name}: wg_address must be a valid IPv6 address"):
            c.check(wga == expected_wg, f"pops.{name}: wg_address {wga} != derived {expected_wg}")
            c.check(mesh is not None and wga in mesh, f"pops.{name}: wg_address {wga} is outside the mesh /64")
            c.check(wga not in wg_addrs, f"pops.{name}: duplicate wg_address {wga}")
            wg_addrs.add(wga)
        lp = raw.get("wg_listen_port", port)
        c.check(isinstance(lp, int) and 1 <= lp <= 65535, f"pops.{name}: wg_listen_port must be 1..65535")
        for fam, ver in (("provider_ipv4", 4), ("provider_ipv6", 6)):
            val = raw.get(fam)
            if val is not None:
                a = parse_addr(val)
                c.check(a is not None and a.version == ver, f"pops.{name}: {fam} {val!r} is not a valid IPv{ver} address")
                if a is not None:
                    c.check(not any(a in n for n in (p4, p6) if n is not None),
                            f"pops.{name}: {fam} {a} must be a provider address, not from our prefixes")
    c.check(len(names) >= 1, "pops: at least one POP is required")

    # ---- BGP -------------------------------------------------------------
    bgp = plan["bgp"]
    c.check(bgp.get("local_asn") == 215520, "bgp.local_asn must be 215520")
    announced = set()
    for entry in bgp.get("prefixes", []):
        net = parse_net(entry.get("prefix"))
        if not c.check(net is not None, f"bgp.prefixes: invalid {entry.get('prefix')!r}"):
            continue
        c.check(net in (p4, p6), f"bgp.prefixes: {net} is neither ipv4.prefix nor ipv6.prefix")
        c.check(entry.get("roa_max_length") == net.prefixlen,
                f"bgp.prefixes: {net} roa_max_length {entry.get('roa_max_length')} != {net.prefixlen}")
        announced.add(net)
    c.check(announced == {n for n in (p4, p6) if n is not None}, "bgp.prefixes must list exactly ipv4.prefix and ipv6.prefix")
    c.check(isinstance(bgp.get("import_limit"), int) and bgp["import_limit"] > 0, "bgp.import_limit must be a positive integer")
    c.check(bgp.get("import_policy") == "default-only", "bgp.import_policy must be 'default-only' (the only policy the template implements)")
    for uname, up in upstreams.items():
        c.check(isinstance(up.get("peer_asn"), int), f"bgp.upstreams.{uname}: peer_asn must be an integer")
        c.check(parse_addr(up.get("peer_ipv4")) is not None and parse_addr(up["peer_ipv4"]).version == 4,
                f"bgp.upstreams.{uname}: invalid peer_ipv4")
        c.check(parse_addr(up.get("peer_ipv6")) is not None and parse_addr(up["peer_ipv6"]).version == 6,
                f"bgp.upstreams.{uname}: invalid peer_ipv6")
        c.check(isinstance(up.get("multihop"), int) and up["multihop"] >= 1, f"bgp.upstreams.{uname}: multihop must be >= 1")
        for field in ("export_communities", "drain_communities"):
            for comm in up.get(field) or []:
                c.check(re.fullmatch(r"\d+:\d+(:\d+)?", str(comm)) is not None,
                        f"bgp.upstreams.{uname}.{field}: malformed community {comm!r}")
                c.check(str(comm) != FORBIDDEN_COMMUNITY, f"bgp.upstreams.{uname}.{field}: {FORBIDDEN_COMMUNITY} must never be set")
                c.check(str(comm) not in (up.get("forbidden_communities") or []),
                        f"bgp.upstreams.{uname}.{field}: {comm} is listed as forbidden for this upstream")
    for comm in bgp.get("drain", {}).get("communities") or []:
        c.check(str(comm) != FORBIDDEN_COMMUNITY, f"bgp.drain.communities: {FORBIDDEN_COMMUNITY} must never be set")
    c.check(isinstance(bgp.get("drain", {}).get("own_prepend"), int) and 0 <= bgp["drain"]["own_prepend"] <= 5,
            "bgp.drain.own_prepend must be 0..5")

    # ---- RPKI / IRR ------------------------------------------------------
    roa_prefixes = set()
    for roa in plan["rpki"].get("roas", []):
        net = parse_net(roa.get("prefix"))
        if not c.check(net is not None, f"rpki.roas: invalid prefix {roa.get('prefix')!r}"):
            continue
        c.check(roa.get("max_length") == net.prefixlen, f"rpki.roas: {net} max_length must equal prefix length {net.prefixlen}")
        c.check(roa.get("asn") == bgp.get("local_asn"), f"rpki.roas: {net} asn must be {bgp.get('local_asn')}")
        roa_prefixes.add(net)
    c.check(roa_prefixes == announced, "rpki.roas must cover exactly the announced prefixes")
    for obj in plan["irr"].get("route_objects", []):
        net = parse_net(obj.get("prefix"))
        c.check(net is not None and net in announced, f"irr.route_objects: {obj.get('prefix')!r} is not an announced prefix")
        c.check(obj.get("origin") == f"AS{bgp.get('local_asn')}", f"irr.route_objects: {obj.get('prefix')} origin must be AS{bgp.get('local_asn')}")
    as_set = plan["irr"].get("as_set", {})
    c.check(f"AS{bgp.get('local_asn')}" in (as_set.get("members") or []), "irr.as_set.members must include AS215520")

    # ---- the one community that must never appear anywhere ----------------
    for path, text in walk_strings(plan):
        if "forbidden_communities" in path:
            continue
        c.check(not re.search(r"(?<![\d:])20473:6000(?![\d:])", text), f"{path}: contains {FORBIDDEN_COMMUNITY}")
    return c


# ---------------------------------------------------------------------------
# Rendering helpers
# ---------------------------------------------------------------------------

def comm_tuple(comm: str) -> str:
    """'20473:6003' -> '(20473, 6003)'; '20473:6001:1' -> '(20473, 6001, 1)' (large)."""
    parts = [int(x) for x in str(comm).split(":")]
    return "(" + ", ".join(str(x) for x in parts) + ")"


def comm_add(comm: str) -> str:
    parts = str(comm).split(":")
    attr = "bgp_large_community" if len(parts) == 3 else "bgp_community"
    return f"{attr}.add({comm_tuple(comm)});"


def placeholder(value: str | None, token: str) -> str:
    return value if value else f"__{token}__"


# ---------------------------------------------------------------------------
# BIRD
# ---------------------------------------------------------------------------

def render_state_conf() -> str:
    return (
        f"# {HEADER}\n"
        "# Rewritten in place by bgp-announce (announce|withdraw|drain|undrain); bird.conf includes it.\n"
        "# Initial state is withdrawn: a freshly deployed node announces nothing until the\n"
        "# health worker has seen the daemon healthy.\n"
        "define ANNOUNCE = false;\n"
        "define DRAIN = false;\n"
    )


def render_bird(plan: dict, pop: Pop) -> str:
    bgp = plan["bgp"]
    up = bgp["upstreams"][pop.upstream_name]
    asn = bgp["local_asn"]
    p4 = plan["ipv4"]["prefix"]
    p6 = plan["ipv6"]["prefix"]
    router_id = placeholder(pop.provider_ipv4, "PROVIDER_IPV4")
    local4 = placeholder(pop.provider_ipv4, "PROVIDER_IPV4")
    local6 = placeholder(pop.provider_ipv6, "PROVIDER_IPV6")
    md5 = '  password "__BGP_MD5__";\n' if up.get("md5_secret_ref") else "  # no MD5 on this upstream\n"
    drain_lines = []
    for _ in range(int(bgp["drain"].get("own_prepend", 0))):
        drain_lines.append(f"    bgp_path.prepend({asn});")
    for comm in list(bgp["drain"].get("communities") or []) + list(up.get("drain_communities") or []):
        drain_lines.append("    " + comm_add(comm))
    export_comm_lines = ["  " + comm_add(c) for c in (up.get("export_communities") or [])]
    drain_block = "\n".join(drain_lines) if drain_lines else "    # (no drain actions configured)"
    export_comms = ("\n".join(export_comm_lines) + "\n") if export_comm_lines else ""
    rtr = bgp.get("rpki_rtr", {})
    rtr_prefix = "" if rtr.get("enabled") else "# "
    svc6 = ", ".join(s["address"] for s in plan["ipv6"]["services"] if s.get("ports"))
    svc4 = ", ".join(s["address"] for s in plan["ipv4"]["services"] if s.get("ports"))
    gr = "on" if bgp.get("graceful_restart", True) else "off"

    def bgp_proto(name: str, family: str, local: str, neighbor: str, import_filter: str, export_filter: str) -> str:
        return f"""protocol bgp {name} {{
  description "{up.get('description', pop.upstream_name)} {family}";
  local {local} as {asn};
  neighbor {neighbor} as {up['peer_asn']};
  multihop {up['multihop']};
{md5}  hold time {bgp.get('hold_time', 90)};
  keepalive time {bgp.get('keepalive_time', 30)};
  graceful restart {gr};
  error wait time 60, 300;
  {family} {{
    import filter {import_filter};
    import limit {bgp['import_limit']} action block;
    export filter {export_filter};
  }};
}}
"""

    return f"""# {HEADER}
# POP {pop.name}: provider {pop.provider}, region {pop.region}, index {pop.index}
# Anycast service addresses (configured on dummy0 by the node, NOT by BIRD):
#   IPv4 {svc4}    IPv6 {svc6}
#   node unicast {pop.node_address}/64 ({pop.unicast_block})
# Placeholders filled at deploy time: __BGP_MD5__ (SOPS); provider addresses come
# from OpenTofu outputs via `netgen --overrides` (unfilled ones read __PROVIDER_...__).

log syslog all;
router id {router_id};

# Announcement state. bgp-announce rewrites this file and runs `birdc configure`.
include "state.conf";

define LOCAL_AS = {asn};

# --- interfaces ------------------------------------------------------------
protocol device {{
  scan time 10;
}}

# No `protocol direct`: interface addresses (the anycast /32 and /128 and the
# node's unicast /64 on dummy0) are never turned into BGP routes. BGP only ever
# sees the two static aggregates below, so a stray address can never leak.

# --- what we originate -----------------------------------------------------
# Aggregates as blackholes: installed in the kernel so that addresses inside our
# prefixes that are not configured locally are dropped here instead of following
# the provider default (loop prevention). Service addresses on dummy0 and the
# other POPs' unicast /64s via wg0 are more specific and win.
protocol static static4 {{
  ipv4;
  route {p4} unreachable;
}}

protocol static static6 {{
  ipv6;
  route {p6} unreachable;
}}

# --- kernel ----------------------------------------------------------------
# Never import kernel routes; export only the static blackholes. The default
# route learned from the upstream is deliberately NOT installed: the instance
# already has its provider default, BGP is for announcing.
protocol kernel kernel4 {{
  learn off;
  persist off;
  ipv4 {{
    import none;
    export where source = RTS_STATIC;
  }};
}}

protocol kernel kernel6 {{
  learn off;
  persist off;
  ipv6 {{
    import none;
    export where source = RTS_STATIC;
  }};
}}

# --- filters ---------------------------------------------------------------
# Import: exactly one default route per family, nothing else (import limit
# {bgp['import_limit']} blocks the session if the upstream misbehaves).
filter import_default4 {{
  if net = 0.0.0.0/0 then accept;
  reject;
}}

filter import_default6 {{
  if net = ::/0 then accept;
  reject;
}}

# Export: allowlist of exactly our aggregate, from static only, gated by
# ANNOUNCE. DRAIN keeps the route but makes it unattractive (own-AS prepend,
# provider prepend community, GRACEFUL_SHUTDOWN 65535:0 per RFC 8326) so that
# traffic drains before a withdraw. The provider's do-not-advertise community
# is never set (bgp.upstreams.*.forbidden_communities); --check and tests enforce it.
filter export_anycast4 {{
  if ! ANNOUNCE then reject;
  if source != RTS_STATIC then reject;
  if net != {p4} then reject;
{export_comms}  if DRAIN then {{
{drain_block}
  }}
  accept;
}}

filter export_anycast6 {{
  if ! ANNOUNCE then reject;
  if source != RTS_STATIC then reject;
  if net != {p6} then reject;
{export_comms}  if DRAIN then {{
{drain_block}
  }}
  accept;
}}

# --- RPKI (optional) -------------------------------------------------------
# A leaf that originates two prefixes and imports only a default has nothing
# to validate, so RTR is off. Enable (bgp.rpki_rtr.enabled) if the import
# policy ever grows beyond default-only; then add `roa_check` to the imports.
{rtr_prefix}roa4 table roa_v4;
{rtr_prefix}roa6 table roa_v6;
{rtr_prefix}protocol rpki rpki_validator {{
{rtr_prefix}  roa4 {{ table roa_v4; }};
{rtr_prefix}  roa6 {{ table roa_v6; }};
{rtr_prefix}  remote "{rtr.get('server', 'rtr.rpki.cloudflare.com')}" port {rtr.get('port', 8282)};
{rtr_prefix}  retry keep 90;
{rtr_prefix}  refresh keep 900;
{rtr_prefix}  expire keep 172800;
{rtr_prefix}}}

# --- upstream sessions -----------------------------------------------------
# Session source must be the instance's main address ({pop.upstream_name}); the
# IPv6 peer may need `ip -6 route add {up['peer_ipv6']}/128 via fe80::1 dev eth0`
# on the host if RA does not provide a route (see docs/research/vultr.md).
{bgp_proto(f"{pop.upstream_name}4", "ipv4", local4, up["peer_ipv4"], "import_default4", "export_anycast4")}
{bgp_proto(f"{pop.upstream_name}6", "ipv6", local6, up["peer_ipv6"], "import_default6", "export_anycast6")}"""


# ---------------------------------------------------------------------------
# WireGuard
# ---------------------------------------------------------------------------

def render_wg(plan: dict, pop: Pop, pops: list[Pop]) -> str:
    wg = plan["wireguard"]
    keys = wg.get("public_keys") or {}
    mesh = ipaddress.ip_network(wg["mesh_prefix"])
    kind = "monitor host (mesh member only: no anycast, no BGP)" if pop.is_monitor else "POP"
    lines = [
        f"# {HEADER}",
        f"# {kind} {pop.name}: WireGuard full mesh, group {pop.mesh_group}. wg-quick format.",
        "# PrivateKey is filled at deploy time from SOPS; the public keys of peers come",
        "# from wireguard.public_keys in the plan or the overrides file.",
        "",
        "[Interface]",
        f"# mesh address for index {pop.index}",
        f"Address = {pop.wg_address}/{mesh.prefixlen}",
        f"ListenPort = {pop.wg_listen_port}",
        "PrivateKey = __WG_PRIVATE_KEY__",
        f"MTU = {wg['mtu']}",
    ]
    if pop.serves:
        lines += [
            "# Other POPs' unicast /64s (inside the anycast /48) arrive here when this POP is",
            "# the client's nearest one and are forwarded to their owner over the mesh.",
            "PostUp = sysctl -q -w net.ipv6.conf.all.forwarding=1",
        ]
    else:
        lines += ["# A monitor forwards nothing: peers are reached on their mesh /128 only."]
    lines.append("")
    peers = [p for p in pops if p.name != pop.name and p.mesh_group == pop.mesh_group]
    if not peers:
        lines.append("# (no peers in this mesh group)")
    for peer in peers:
        host = peer.wg_endpoint_host(wg.get("endpoint_preference", ["provider_ipv6", "provider_ipv4"]))
        pubkey = keys.get(peer.name)
        if host is None or not pubkey:
            # A peer whose public key or endpoint is not known yet is left out
            # (commented) so the file stays loadable by wg-quick; it appears
            # once overrides carry its values.
            lines += [f"# [Peer] {peer.name}: not yet provisioned (missing "
                      + ("endpoint" if host is None else "public key") + "); rerun netgen with overrides",
                      ""]
            continue
        if ":" in host:
            endpoint = f"[{host}]:{peer.wg_listen_port}"
        else:
            endpoint = f"{host}:{peer.wg_listen_port}"
        # A peer's unicast /64 is backhauled only when it has one (a monitor
        # has none) AND this node forwards (a monitor does not): the monitor
        # must reach the POPs' /48 addresses through the public anycast path,
        # which is exactly what its blackbox probes are meant to measure.
        allowed = f"{peer.wg_address}/128"
        if pop.serves and peer.unicast_block is not None:
            allowed += f", {peer.unicast_block}"
        what = "monitor" if peer.is_monitor else f"{peer.provider} {peer.region}"
        lines += [
            "[Peer]",
            f"# {peer.name} ({what}) index {peer.index}",
            f"PublicKey = {pubkey}",
            f"Endpoint = {endpoint}",
            f"AllowedIPs = {allowed}",
            f"PersistentKeepalive = {wg['persistent_keepalive']}",
            "",
        ]
    return "\n".join(lines).rstrip("\n") + "\n"


# ---------------------------------------------------------------------------
# DNS, nftables, summary
# ---------------------------------------------------------------------------

def render_dns(plan: dict, pops: list[Pop]) -> str:
    service_hostname = next((s.get("dns") for s in plan["ipv6"]["services"] if s.get("dns")), "git")
    doc = {
        "zone_name": plan["zone"],
        "service_hostname": service_hostname,
        "nodes_subdomain": plan.get("nodes_subdomain", "nodes"),
        "anycast_v4": sorted(s["address"] for s in plan["ipv4"]["services"] if s.get("dns")),
        "anycast_v6": sorted(str(ipaddress.ip_address(s["address"])) for s in plan["ipv6"]["services"] if s.get("dns")),
        # <pop>.nodes.<zone>: unicast address from our /48 (reachable through the
        # nearest POP plus the mesh) and the provider IPv4 (directly reachable).
        # A monitor has no /48 address, so both of its records are provider ones.
        "nodes": {
            p.name: {"ipv4": p.provider_ipv4,
                     "ipv6": str(p.node_address) if p.node_address is not None else p.provider_ipv6}
            for p in pops if p.dns and p.public
        },
        # Provider addresses only, for a second module instance (e.g.
        # nodes_subdomain = "direct") when management must not depend on the mesh.
        "nodes_provider": {
            p.name: {"ipv4": p.provider_ipv4, "ipv6": p.provider_ipv6}
            for p in pops if p.dns and p.public
        },
    }
    body = yaml.safe_dump(doc, sort_keys=True, default_flow_style=False, allow_unicode=False)
    return (
        f"# {HEADER}\n"
        "# Feed `nodes`, `anycast_v4`, `anycast_v6` to infra/opentofu/modules/cloudflare-dns.\n"
        "# null provider addresses mean the instance is not deployed yet (no A record).\n"
        + body
    )


def nft_set(name: str, values: list[str], empty_note: str = "no values known yet") -> str:
    if not values:
        return f"# define {name}: empty ({empty_note})\n"
    return f"define {name} = {{ {', '.join(values)} }}\n"


def render_nft(plan: dict, pops: list[Pop]) -> str:
    public = [p for p in pops if p.public]
    # Service nodes carry /48 unicast and run BGP; a monitor is only a mesh peer.
    serving = [p for p in public if p.serves]
    upstreams = plan["bgp"]["upstreams"]
    used_upstreams = sorted({p.upstream_name for p in public if p.bgp})
    catalogue = plan.get("services") or {}
    # Every public port any service can open, from the catalogue.
    svc_ports = sorted({port for svc in catalogue.values() for port in (svc.get("public_tcp") or [])})
    out = [
        f"# {HEADER}",
        "# nftables variables for the host firewall (include from the ruleset with",
        '# `include "nftables-vars.nft"`). The address and mesh sets are global;',
        "# the pop_<name>_* port sets are per POP, because a POP only opens the",
        "# ports of the services it runs (address-plan.yaml `services:`).",
        "",
        f"define anycast_prefix_v4 = {plan['ipv4']['prefix']}",
        f"define anycast_prefix_v6 = {plan['ipv6']['prefix']}",
        nft_set("anycast_v4", sorted(s["address"] for s in plan["ipv4"]["services"] if s.get("ports"))).rstrip("\n"),
        nft_set("anycast_v6", sorted(s["address"] for s in plan["ipv6"]["services"] if s.get("ports"))).rstrip("\n"),
        nft_set("service_ports", [str(p) for p in svc_ports]).rstrip("\n"),
        "",
        "# Per-POP unicast (from the /48) and the WireGuard mesh (mesh sets include the monitor)",
        nft_set("node_unicast_v6", [str(p.node_address) for p in serving]).rstrip("\n"),
        nft_set("node_unicast_blocks_v6", [str(p.unicast_block) for p in serving]).rstrip("\n"),
        f"define wg_mesh_v6 = {plan['wireguard']['mesh_prefix']}",
        nft_set("wg_nodes_v6", [str(p.wg_address) for p in public]).rstrip("\n"),
        f"define wg_port = {plan['wireguard']['listen_port']}",
        nft_set("wg_endpoints_v4", [p.provider_ipv4 for p in public if p.provider_ipv4]).rstrip("\n"),
        nft_set("wg_endpoints_v6", [p.provider_ipv6 for p in public if p.provider_ipv6]).rstrip("\n"),
        "",
        "# BGP peers (TCP/179, multihop): allow in both directions",
        nft_set("bgp_peers_v4", [upstreams[u]["peer_ipv4"] for u in used_upstreams]).rstrip("\n"),
        nft_set("bgp_peers_v6", [upstreams[u]["peer_ipv6"] for u in used_upstreams]).rstrip("\n"),
        "",
        "# Per-POP ports. public_tcp is the union of the POP's services'",
        "# public_tcp; private_tcp adds the platform's own mesh ports",
        "# (node_private_tcp). modules/forge-node renders the same values into",
        "# /etc/nftables.conf; these are the generated cross-check.",
    ]
    for p in public:
        note = "runs no services" if not p.services else "this POP's services open no public ports"
        out.append(nft_set(f"pop_{p.name}_public_tcp", [str(x) for x in p.public_tcp], note).rstrip("\n"))
        out.append(nft_set(f"pop_{p.name}_private_tcp", [str(x) for x in p.private_tcp]).rstrip("\n"))
    return "\n".join(out) + "\n"


def render_summary(plan: dict, pops: list[Pop]) -> str:
    wg = plan["wireguard"]
    bgp = plan["bgp"]
    lines = [
        f"<!-- {HEADER} -->",
        "# Network plan summary",
        "",
        f"Zone `{plan['zone']}`, AS{bgp['local_asn']}. Announced from every POP: "
        f"`{plan['ipv4']['prefix']}` and `{plan['ipv6']['prefix']}`.",
        "",
        "## Service addresses (anycast)",
        "",
        "| Service | IPv4 | IPv6 | Ports | DNS |",
        "| --- | --- | --- | --- | --- |",
    ]
    v6_by_name = {s["name"]: s for s in plan["ipv6"]["services"]}
    for s4 in plan["ipv4"]["services"]:
        s6 = v6_by_name.get(s4["name"], {})
        dns = f"{s4.get('dns')}.{plan['zone']}" if s4.get("dns") else "-"
        lines.append(f"| {s4['name']} | `{s4['address']}` | `{s6.get('address', '-')}` | {', '.join(map(str, s4.get('ports') or [])) or '-'} | {dns} |")
    for s6 in plan["ipv6"]["services"]:
        if s6["name"] not in {s["name"] for s in plan["ipv4"]["services"]}:
            lines.append(f"| {s6['name']} | - | `{s6['address']}` | {', '.join(map(str, s6.get('ports') or [])) or '-'} | - |")
    lines += [
        "",
        "## POPs",
        "",
        "| POP | Provider | Region | Index | Unicast /64 | Node address | Mesh address | Provider IPv4 | Provider IPv6 | Services | Roles | Public TCP |",
        "| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |",
    ]
    for p in pops:
        block = f"`{p.unicast_block}`" if p.unicast_block is not None else "-"
        node = f"`{p.node_address}`" if p.node_address is not None else "-"
        # A critical service is marked *: its failure withdraws the POP (ADR 0014).
        svc = ", ".join(f"{s}*" if s in p.critical_services else s for s in p.services) or "-"
        lines.append(
            f"| {p.name} | {p.provider} | {p.region} | {p.index} | {block} | {node} | "
            f"`{p.wg_address}` | {p.provider_ipv4 or '_unassigned_'} | {p.provider_ipv6 or '_unassigned_'} | "
            f"{svc} | {', '.join(p.roles)} | {', '.join(str(x) for x in p.public_tcp) or '-'} |"
        )
    lines.append("")
    lines.append("`*` = critical: a failed health check withdraws the POP from anycast (ADR 0014).")
    lines += [
        "",
        "## IPv6 layout",
        "",
        "| Prefix | Purpose |",
        "| --- | --- |",
    ]
    for r in plan["ipv6"]["regions"]:
        lines.append(f"| `{r['prefix']}` | region: {r['purpose']} |")
    for s in plan["ipv6"]["subnets"]:
        lines.append(f"| `{s['prefix']}` | {s['purpose']} |")
    lines.append(f"| `{plan['ipv6']['pop_unicast_template']}` | per-POP unicast (index in hex) |")
    lines += [
        "",
        "## IPv4 layout",
        "",
        "| Range | Purpose |",
        "| --- | --- |",
    ]
    for s in plan["ipv4"]["services"]:
        lines.append(f"| `{s['address']}` | anycast service {s['name']} |")
    for r in plan["ipv4"]["reserved"]:
        lines.append(f"| `{r['range']}` | {r['purpose']} |")
    lines += [
        "",
        "## WireGuard mesh",
        "",
        f"ULA `{wg['ula_prefix']}` (RFC 4193), mesh `{wg['mesh_prefix']}`, UDP {wg['listen_port']}, MTU {wg['mtu']}, "
        f"keepalive {wg['persistent_keepalive']}s, IPv6-only, full mesh within a group (production / lab).",
        "AllowedIPs per peer = its mesh /128 plus its unicast /64 (backhaul for unicast-inside-anycast).",
        "",
        "## BGP",
        "",
        f"- Import: default route only, `import limit {bgp['import_limit']} action block`, not installed in the kernel.",
        "- Export: exactly the two aggregates from static routes; `ANNOUNCE=false` exports nothing.",
        f"- Drain: prepend AS{bgp['local_asn']} x{bgp['drain']['own_prepend']}, communities "
        f"{', '.join(bgp['drain']['communities'])} plus per-upstream drain communities.",
        "- Never set: the provider do-not-advertise community (`forbidden_communities` in the plan).",
        "",
        "| Upstream | Peer ASN | Peer IPv4 | Peer IPv6 | Multihop | MD5 | Drain communities |",
        "| --- | --- | --- | --- | --- | --- | --- |",
    ]
    for name, up in sorted(bgp["upstreams"].items()):
        lines.append(
            f"| {name} | {up['peer_asn']} | `{up['peer_ipv4']}` | `{up['peer_ipv6']}` | {up['multihop']} | "
            f"{'yes' if up.get('md5_secret_ref') else 'no'} | {', '.join(up.get('drain_communities') or []) or '-'} |"
        )
    lines += [
        "",
        "## Registry state to make true",
        "",
        "| Item | Value | Status |",
        "| --- | --- | --- |",
    ]
    for roa in plan["rpki"]["roas"]:
        lines.append(f"| ROA | `{roa['prefix']}` maxLength {roa['max_length']} AS{roa['asn']} ({roa['ta']}) | {roa['status']} |")
    for obj in plan["irr"]["route_objects"]:
        lines.append(f"| route object | `{obj['prefix']}` origin {obj['origin']} in {obj['source']} | {obj['status']} |")
    a = plan["irr"]["as_set"]
    lines.append(f"| as-set | `{a['name']}` members {', '.join(a['members'])} ({a['source']}) | {a['status']} |")
    for z in plan.get("rdns", {}).get("zones", []):
        lines.append(f"| rDNS | `{z['zone']}` via {z['delegate_via']} | pending |")
    return "\n".join(lines) + "\n"


# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------

def write_file(path: str, content: str) -> None:
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8", newline="\n") as fh:
        fh.write(content)


def prune_pop_dirs(base: str, keep: set[str]) -> None:
    if not os.path.isdir(base):
        return
    for entry in os.listdir(base):
        full = os.path.join(base, entry)
        if os.path.isdir(full) and entry not in keep:
            shutil.rmtree(full)


def generate(plan: dict, out_root: str) -> list[str]:
    pops = build_pops(plan)
    written: list[str] = []
    bird_base = os.path.join(out_root, "infra", "bird", "generated")
    wg_base = os.path.join(out_root, "infra", "wireguard", "generated")
    net_base = os.path.join(out_root, "infra", "network", "generated")
    prune_pop_dirs(bird_base, {p.name for p in pops if p.bgp})
    prune_pop_dirs(wg_base, {p.name for p in pops})
    for pop in pops:
        outputs = []
        if pop.bgp:  # a monitor runs no BIRD
            outputs += [
                (os.path.join(bird_base, pop.name, "bird.conf"), render_bird(plan, pop)),
                (os.path.join(bird_base, pop.name, "state.conf"), render_state_conf()),
            ]
        outputs.append((os.path.join(wg_base, pop.name, "wg0.conf"), render_wg(plan, pop, pops)))
        for rel, content in outputs:
            write_file(rel, content)
            written.append(rel)
    for rel, content in (
        (os.path.join(net_base, "dns-nodes.yaml"), render_dns(plan, pops)),
        (os.path.join(net_base, "nftables-vars.nft"), render_nft(plan, pops)),
        (os.path.join(net_base, "summary.md"), render_summary(plan, pops)),
    ):
        write_file(rel, content)
        written.append(rel)
    return written


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(prog="netgen", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--plan", default=DEFAULT_PLAN, help="address plan YAML (default: infra/network/address-plan.yaml)")
    ap.add_argument("--overrides", help="YAML with provider-assigned addresses and WireGuard public keys")
    ap.add_argument("--out-root", default=REPO_ROOT, help="directory that contains infra/ (default: repository root)")
    ap.add_argument("--check", action="store_true", help="validate the plan and exit without writing")
    ap.add_argument("-q", "--quiet", action="store_true")
    args = ap.parse_args(argv)

    plan = load_yaml(args.plan)
    if args.overrides:
        plan = merge_overrides(plan, load_yaml(args.overrides))
    checker = validate(plan)
    if checker.errors:
        for err in checker.errors:
            print(f"error: {err}", file=sys.stderr)
        print(f"netgen --check: FAIL ({len(checker.errors)} error(s), {checker.passed} checks passed)", file=sys.stderr)
        return 1
    if args.check:
        pops = build_pops(plan)
        print(f"netgen --check: OK ({checker.passed} checks passed; {len(pops)} POPs: {', '.join(p.name for p in pops)})")
        return 0
    written = generate(plan, os.path.abspath(args.out_root))
    if not args.quiet:
        for path in written:
            print(os.path.relpath(path, os.path.abspath(args.out_root)))
    return 0


if __name__ == "__main__":
    sys.exit(main())
