#!/usr/bin/env bash
# scripts/deploy: push the forge binary, generated configs and secrets to a
# node over SSH, apply, smoke-test. Works against a node booted by
# infra/cloud-init/node.yaml.tftpl (Vultr via OpenTofu) or against any Debian
# 13 box prepared with `deploy bootstrap` (docs/self-hosting.md).
#
#   deploy <pop> [--binary bin/forge] [--host user@host] [--config-dir DIR] [--no-secrets] [--dry-run]
#   deploy init-node <pop> [--host user@host] [--rotate-key] [--known-hosts-line L | --hostkey-fingerprint SHA256:...]
#                                                 pin the node's sshd host key in infra/known_hosts; record its age
#                                                 recipient in infra/secrets/nodes/<pop>.age.pub
#   deploy sysupdate <pop> [--host root@host]     as root: refresh units, forge-deploy-helper, bgp-announce, forge-backup, sudoers
#   deploy bootstrap <pop> --host root@host [--known-hosts-line L | --hostkey-fingerprint F]
#                                                 prepare a hand-installed box (users, packages, sshd :2200, helper, age key)
#   deploy rollback <pop>                         swap /usr/local/bin/forge.prev back and restart
#   deploy drain <pop> | undrain <pop>            withdraw/announce via bgp-announce on the node
#   deploy status <pop>                           unit states, wg0, bird, last forge log lines
#   deploy smoke <pop>                            Gemini + SSH banner checks only
#   deploy monitor <mon> [--host root@host] [--config-dir DIR] [--hostkey-fingerprint F | --known-hosts-line L]
#                                                 as root: Grafana from its pinned apt repo, prometheus.yml (tofu output
#                                                 monitor_configs), rules, blackbox.yml, dashboard, wg0.conf (+ key),
#                                                 nftables.conf; reload/restart the units (docs/monitoring.md)
#
# Environment: FORGE_SSH_IDENTITY (private key for the deploy user),
# FORGE_ENV (dev), FORGE_ZONE (as215520.net), FORGE_ADMIN_PORT
# (2200), FORGE_DEPLOY_USER (deploy).
#
# Remote side (SR-19a): the `deploy` user may sudo exactly one command,
# /usr/local/sbin/forge-deploy-helper (infra/systemd/forge-deploy-helper).
# Every file travels on the helper's stdin and lands only at an allow-listed
# path: the binary (sha256-checked), forge.toml, nftables.conf, bird.conf and
# wg0.conf (as placeholder templates), state.conf, and the node's secret
# bundle. Root-executed code (units, the helper, bgp-announce, forge-backup)
# is installed by cloud-init and refreshed only by `deploy sysupdate` as root.
#
# Secrets (SR-02): the node's subset of infra/secrets/$FORGE_ENV.enc.yaml is
# extracted with scripts/secrets, tarred, age-encrypted to the node's own
# recipient and stored as /etc/forge/secrets.tar.age; forge-secrets.service
# decrypts it into /run/forge (tmpfs) at boot and on every `apply`. Nothing
# decrypted ever rests on the node's root filesystem. Host keys (SR-19b) are
# pinned in infra/known_hosts (StrictHostKeyChecking=yes).
set -euo pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd)
ENV_NAME=${FORGE_ENV:-dev}
ZONE=${FORGE_ZONE:-as215520.net}
PORT=${FORGE_ADMIN_PORT:-2200}
USER_=${FORGE_DEPLOY_USER:-deploy}
BUNDLE="$ROOT/infra/secrets/$ENV_NAME.enc.yaml"
TOFU_DIR="$ROOT/infra/opentofu/environments/$ENV_NAME"
KNOWN_HOSTS="$ROOT/infra/known_hosts"
HELPER=/usr/local/sbin/forge-deploy-helper
SSH_OPTS=(-o BatchMode=yes -o ConnectTimeout=15 -o StrictHostKeyChecking=yes -o "UserKnownHostsFile=$KNOWN_HOSTS")
# FORGE_SSH_IDENTITY selects the operator key (default: ssh's own identity search).
[ -n "${FORGE_SSH_IDENTITY:-}" ] && SSH_OPTS+=(-i "$FORGE_SSH_IDENTITY" -o IdentitiesOnly=yes)
DRY=0; BINARY=""; HOST=""; CONFIG_DIR=""; WITH_SECRETS=1; ROTATE_KEY=0; KH_LINE=""; KH_FP=""
TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT

log() { printf '\033[1mdeploy:\033[0m %s\n' "$*" >&2; }
die() { echo "deploy: $*" >&2; exit 1; }
usage() { sed -n '2,/^set -euo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

parse_opts() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --binary) BINARY=$2; shift 2;;
      --host) HOST=$2; shift 2;;
      --config-dir) CONFIG_DIR=$2; shift 2;;
      --no-secrets) WITH_SECRETS=0; shift;;
      --rotate-key) ROTATE_KEY=1; shift;;
      --known-hosts-line) KH_LINE=$2; shift 2;;
      --hostkey-fingerprint) KH_FP=$2; shift 2;;
      --dry-run|-n) DRY=1; shift;;
      -h|--help) usage 0;;
      *) die "unknown option $1";;
    esac
  done
}

target() { # $1 pop -> user@host (deploy user unless --host)
  if [ -n "$HOST" ]; then echo "$HOST"; else echo "$USER_@$1.nodes.$ZONE"; fi
}
root_target() { # $1 pop -> root@host (sysupdate/bootstrap: the provider-injected bootstrap key)
  if [ -n "$HOST" ]; then echo "$HOST"; else echo "root@$1.nodes.$ZONE"; fi
}
host_only() { echo "${1#*@}"; }

# --- host keys (SR-19b) -------------------------------------------------------
# infra/known_hosts is committed (public data). Entries use ssh's own naming:
# "host" for port 22, "[host]:port" otherwise.
kh_name() { if [ "$PORT" = 22 ]; then echo "$1"; else echo "[$1]:$PORT"; fi; }
kh_has() { [ -s "$KNOWN_HOSTS" ] && ssh-keygen -F "$(kh_name "$1")" -f "$KNOWN_HOSTS" >/dev/null 2>&1; }
kh_add() { # kh_add <host> <keytype> <key>
  install -d "$(dirname "$KNOWN_HOSTS")"
  printf '%s %s %s\n' "$(kh_name "$1")" "$2" "$3" >> "$KNOWN_HOSTS"
  log "pinned $(kh_name "$1") in ${KNOWN_HOSTS#$ROOT/} (commit it)"
}
require_pinned() { # every command except init-node/bootstrap refuses an unpinned host
  local h=$1
  kh_has "$h" && return 0
  [ "$DRY" = 1 ] && { log "WARNING: $h is not pinned in ${KNOWN_HOSTS#$ROOT/}; a real run needs: deploy init-node <pop> --hostkey-fingerprint SHA256:..."; return 0; }
  die "$(kh_name "$h") is not in ${KNOWN_HOSTS#$ROOT/}; pin it first: deploy init-node <pop> --hostkey-fingerprint SHA256:... (or --known-hosts-line), see docs/runbooks/deploy-first-node.md"
}
pin_hostkey() { # pin_hostkey <host>: from --known-hosts-line (console) or --hostkey-fingerprint (console) + ssh-keyscan
  local h=$1 type key line fp
  if kh_has "$h"; then log "$(kh_name "$h") already pinned"; return 0; fi
  if [ -n "$KH_LINE" ]; then
    # accept "[name]:port ssh-ed25519 AAAA..." (as printed on the node console) or "ssh-ed25519 AAAA..."
    set -- $KH_LINE
    case "$#" in 3) type=$2 key=$3;; 2) type=$1 key=$2;; *) die "--known-hosts-line: expected '[host]:port ssh-ed25519 KEY'";; esac
    case "$type" in ssh-ed25519|ecdsa-sha2-*|ssh-rsa) ;; *) die "--known-hosts-line: unknown key type $type";; esac
    [ "$DRY" = 1 ] && { echo "  pin $(kh_name "$h") $type $key" >&2; return 0; }
    kh_add "$h" "$type" "$key"
  elif [ -n "$KH_FP" ]; then
    case "$KH_FP" in SHA256:*) ;; *) die "--hostkey-fingerprint: expected SHA256:... (ssh-keygen -lf format, as printed on the node console)";; esac
    [ "$DRY" = 1 ] && { echo "  ssh-keyscan -p $PORT -t ed25519 $h ; verify == $KH_FP ; pin" >&2; return 0; }
    line=$(ssh-keyscan -p "$PORT" -t ed25519 -T 10 "$h" 2>/dev/null | grep -v '^#' | head -1 || true)
    [ -n "$line" ] || die "ssh-keyscan got no ed25519 key from $h:$PORT"
    fp=$(printf '%s\n' "$line" | ssh-keygen -lf /dev/stdin | awk '{print $2}')
    [ "$fp" = "$KH_FP" ] || die "host key fingerprint mismatch for $h: scanned $fp, expected $KH_FP (wrong host, or a MITM)"
    set -- $line; kh_add "$h" "$2" "$3"
  else
    die "$(kh_name "$h") is not pinned; pass --known-hosts-line '<line from the node console>' or --hostkey-fingerprint SHA256:<from the console> (docs/runbooks/deploy-first-node.md step 2)"
  fi
}

# --- remote execution -----------------------------------------------------------
# All remote actions go through these so --dry-run can show the plan.
helper() { # helper <target> <verb> [args]: the deploy user's only sudo command; no stdin
  local t=$1; shift
  if [ "$DRY" = 1 ]; then echo "  ssh $t: sudo forge-deploy-helper $*" >&2; return 0; fi
  ssh -n "${SSH_OPTS[@]}" -p "$PORT" "$t" sudo -n "$HELPER" "$@"
}
helper_file() { # helper_file <target> <local file> <verb> [args]: file on stdin; silently skipped if missing
  local t=$1 src=$2; shift 2
  [ -f "$src" ] || return 0
  if [ "$DRY" = 1 ]; then echo "  ssh $t: sudo forge-deploy-helper $* < ${src#$ROOT/}" >&2; return 0; fi
  ssh "${SSH_OPTS[@]}" -p "$PORT" "$t" sudo -n "$HELPER" "$@" < "$src"
}
shquote() { # shquote <arg>...: single-quote each argument for a remote POSIX shell (ssh flattens argv into one string)
  local a out=""
  for a in "$@"; do out+=" '${a//\'/\'\\\'\'}'"; done
  printf '%s' "${out# }"
}
rscript() { # rscript <root@host> [args...] <<'EOT' ... EOT : run a root shell script from stdin (bootstrap/sysupdate only)
  local t=$1; shift
  if [ "$DRY" = 1 ]; then echo "  ssh $t: sh -s -- $(shquote "$@") <<EOT" >&2; sed 's/^/    /' >&2; echo "  EOT" >&2; return 0; fi
  # Arguments travel quoted: ssh joins them with spaces and the remote shell
  # re-splits, which would break any value containing whitespace.
  ssh "${SSH_OPTS[@]}" -p "$PORT" "$t" "sh -s -- $(shquote "$@")"
}
root_file() { # root_file <root@host> <local> <remote> <mode>: install a file as root (sysupdate/bootstrap)
  local t=$1 src=$2 dst=$3 mode=$4
  [ -f "$src" ] || die "missing $src"
  if [ "$DRY" = 1 ]; then echo "  ssh $t: install ${src#$ROOT/} -> $dst ($mode)" >&2; return 0; fi
  ssh "${SSH_OPTS[@]}" -p "$PORT" "$t" sh -c "'umask 022; cat > $dst.tmp && chown root:root $dst.tmp && chmod $mode $dst.tmp && mv -f $dst.tmp $dst'" < "$src"
}

# --- pieces -----------------------------------------------------------------------
build_binary() {
  local out=$1
  log "building linux/amd64 static binary"
  if [ "$DRY" = 1 ]; then echo "  GOOS=linux GOARCH=amd64 CGO_ENABLED=0 go build -o $out ./cmd/forge" >&2; return 0; fi
  local version; version=$(git -C "$ROOT" describe --tags --always --dirty 2>/dev/null || echo dev)
  (cd "$ROOT" && GOOS=linux GOARCH=amd64 CGO_ENABLED=0 \
    go build -trimpath -ldflags "-s -w -X as215520.net/forge/internal/version.Version=$version" -o "$out" ./cmd/forge)
}

push_binary() { # push_binary <target> <binary>: sha256 travels as the argument, bytes on stdin
  local t=$1 bin=$2 sum="<sha256>"
  [ "$DRY" = 1 ] || sum=$(sha256sum "$bin" | cut -d' ' -f1)
  log "installing binary atomically (previous kept as forge.prev)"
  if [ "$DRY" = 1 ]; then echo "  ssh $t: sudo forge-deploy-helper install-binary $sum < $bin" >&2; return 0; fi
  helper_file "$t" "$bin" install-binary "$sum"
}

render_configs() { # render_configs <pop> <dir>: forge.toml + nftables.conf from tofu outputs or --config-dir
  local pop=$1 dir=$2
  if [ -n "$CONFIG_DIR" ]; then cp "$CONFIG_DIR"/forge.toml "$CONFIG_DIR"/nftables.conf "$dir"/ 2>/dev/null || true; return 0; fi
  if command -v tofu >/dev/null 2>&1 && [ -d "$TOFU_DIR" ] && [ -e "$TOFU_DIR/terraform.tfstate" ]; then
    # Outputs are maps keyed by POP name.
    local out
    for out in forge_toml:forge.toml nftables_conf:nftables.conf; do
      tofu -chdir="$TOFU_DIR" output -json "${out%%:*}" 2>/dev/null \
        | python3 -c 'import json,sys; d=json.load(sys.stdin); v=d.get(sys.argv[1]); sys.stdout.write(v) if v else sys.exit(1)' "$pop" \
        > "$dir/${out#*:}" || rm -f "$dir/${out#*:}"
    done
  fi
  [ -s "$dir/forge.toml" ] || log "no rendered forge.toml (no tofu state / --config-dir); keeping the node's current one"
}

push_configs() { # push_configs <target> <pop> <dir>: data files only; the helper validates and places them
  local t=$1 pop=$2 dir=$3
  log "pushing configs (forge.toml, nftables.conf, bird.conf, state.conf, wg0.conf)"
  helper_file "$t" "$dir/forge.toml" write-config forge.toml
  helper_file "$t" "$dir/nftables.conf" write-config nftables.conf
  # Generated by the network agent's scripts/netgen (referenced, not created here).
  # bird.conf / wg0.conf keep their __BGP_MD5__ / __WG_PRIVATE_KEY__ placeholders
  # on disk (as bird.conf.in / wg0.conf.in); forge-secrets renders them into
  # /run/forge. state.conf holds live announce/drain state: the helper only
  # seeds it when the node has none or still has the cloud-init placeholder.
  helper_file "$t" "$ROOT/infra/bird/generated/$pop/bird.conf" write-config bird.conf
  helper_file "$t" "$ROOT/infra/bird/generated/$pop/state.conf" write-config state.conf
  helper_file "$t" "$ROOT/infra/wireguard/generated/$pop/wg0.conf" write-config wg0.conf
  helper_file "$t" "$ROOT/infra/mirror/known_hosts" write-config mirror_known_hosts
}

# Secrets: extract this node's subset from the SOPS bundle, tar it, encrypt to
# the node's age recipient, ship as /etc/forge/secrets.tar.age. The node
# decrypts it into tmpfs (forge-secrets.service) with /etc/forge/age.key.
push_secrets() { # push_secrets <target> <pop>
  local t=$1 pop=$2; local recip_file="$ROOT/infra/secrets/nodes/$pop.age.pub"
  [ -s "$BUNDLE" ] || { log "no bundle $BUNDLE; skipping secrets"; return 0; }
  [ -s "$recip_file" ] || die "no node recipient at $recip_file; run: deploy init-node $pop"
  local recip; recip=$(tr -d '[:space:]' < "$recip_file")
  local tmp="$TMP/secrets-$pop"; rm -rf "$tmp"
  local s="$ROOT/scripts/secrets" d="$tmp/secrets"
  install -d -m 0700 "$d/tls" "$d/ssh"
  log "extracting secrets for $pop from ${BUNDLE#$ROOT/}"
  if [ "$DRY" = 1 ]; then
    echo "  (sops -d --extract x8 -> tar | age -r $recip -> secrets.tar.age)" >&2
    echo "  ssh $t: sudo forge-deploy-helper write-config secrets < secrets.tar.age   (-> /etc/forge/secrets.tar.age, 0600 root)" >&2
    return 0
  fi
  get() { "$s" get "$BUNDLE" "$1" 2>/dev/null || true; }
  get forge_tls_key   > "$d/tls/server.key"
  get forge_tls_cert  > "$d/tls/server.crt"
  get ssh_host_key    > "$d/ssh/host_ed25519"
  get cluster_secret  > "$d/cluster.secret"
  get "wireguard_private_keys.$pop" > "$d/wg.key"
  get vultr_bgp_password > "$d/bgp.password"
  get mirror_deploy_key > "$d/mirror.key"
  bk=$(get backup_encryption_key)
  if [ -n "$bk" ] && [ "${bk#AGE-SECRET-KEY-}" != "$bk" ]; then
    printf '%s\n' "$bk" | age-keygen -y > "$d/backup.recipient" 2>/dev/null || true
  fi
  for f in "$d"/tls/* "$d"/ssh/* "$d"/*; do [ -f "$f" ] && [ ! -s "$f" ] && rm -f "$f"; done
  # grep exits 1 when nothing matches; do not let pipefail abort the deploy.
  { grep -rl '^REPLACE' "$d" 2>/dev/null || true; } | while read -r f; do log "WARNING: placeholder value in ${f#$d/}"; rm -f "$f"; done
  chmod -R go-rwx "$d"
  tar -C "$d" -cf - . | age -r "$recip" -o "$tmp/secrets.tar.age"
  rm -rf "$d"
  helper_file "$t" "$tmp/secrets.tar.age" write-config secrets
}

apply_node() { # apply_node <target>: nftables, forge-secrets (tmpfs render), wg0, bird, forge; journal on failure
  log "applying: nftables, forge-secrets -> /run/forge, wg0, bird, forge"
  helper "$1" apply
}

smoke() { # smoke <pop> - against the node's own unicast name (not the anycast name)
  local pop=$1 h; h=$(host_only "$(target "$pop")")
  log "smoke test against $h"
  [ "$DRY" = 1 ] && { echo "  gemini://$h/status ; ssh banner on $h:22" >&2; return 0; }
  local ok=1
  if command -v openssl >/dev/null 2>&1; then
    local conn="$h:1965"; case "$h" in *:*) conn="[$h]:1965";; esac # bracket IPv6 literals only
    # The health controller reports 41 "starting" until several check cycles
    # have passed (docs/health.md); allow up to two minutes for that.
    local resp="" i
    for i in $(seq 1 24); do
      resp=$(printf 'gemini://git.%s/status\r\n' "$ZONE" | timeout 10 openssl s_client -quiet -nocommands -connect "$conn" -servername "git.$ZONE" 2>/dev/null | head -1 | tr -d '\r' || true)
      case "$resp" in 2*|3*) break;; 41*starting*) sleep 5;; *) break;; esac
    done
    case "$resp" in 2*|3*) log "gemini: $resp";; *) log "gemini FAILED: '${resp:-no response}'"; ok=0;; esac
  fi
  # Read one line: the banner is shorter than 64 bytes, so head -c would wait.
  local banner; banner=$(timeout 5 bash -c "exec 3<>/dev/tcp/$h/22; head -n 1 <&3" 2>/dev/null | tr -d '\r' || true)
  case "$banner" in SSH-2.0*) log "ssh: $banner";; *) log "ssh FAILED: '${banner:-no banner}'"; ok=0;; esac
  [ "$ok" = 1 ] || die "smoke test failed on $pop"
}

# Root-executed files: the units, the helper, bgp-announce, forge-backup and
# the scoped sudoers rule. Installed by cloud-init; refreshed here as root.
push_system_files() { # push_system_files <root@host>
  local t=$1 u
  log "installing root-executed files (units, forge-deploy-helper, bgp-announce, forge-backup) as root"
  root_file "$t" "$ROOT/infra/systemd/forge-deploy-helper" "$HELPER" 0755
  root_file "$t" "$ROOT/infra/systemd/forge-bgp-request" /usr/local/bin/forge-bgp-request 0755
  root_file "$t" "$ROOT/infra/systemd/forge-bgp-exec" /usr/local/sbin/forge-bgp-exec 0755
  for u in forge.service forge-secrets.service forge-maintenance.service forge-maintenance.timer forge-backup.service forge-backup.timer forge-bgp.service forge-bgp.path; do
    root_file "$t" "$ROOT/infra/systemd/$u" "/etc/systemd/system/$u" 0644
  done
  root_file "$t" "$ROOT/infra/backup/forge-backup" /usr/local/bin/forge-backup 0755
  root_file "$t" "$ROOT/scripts/bgp-announce" /usr/local/bin/bgp-announce 0755
  # bird_exporter (docs/monitoring.md): the package plus our unit of the same
  # name, which shadows the packaged one. Nodes built before it was in
  # cloud-init get the package here.
  root_file "$t" "$ROOT/infra/monitoring/bird-exporter.service" /etc/systemd/system/prometheus-bird-exporter.service 0644
  rscript "$t" <<'EOT'
set -e
printf 'deploy ALL=(root) NOPASSWD: /usr/local/sbin/forge-deploy-helper *\n' > /etc/sudoers.d/deploy.tmp
chmod 0440 /etc/sudoers.d/deploy.tmp && mv -f /etc/sudoers.d/deploy.tmp /etc/sudoers.d/deploy
# nodes built before SR-19a: drop cloud-init's blanket rule
[ -f /etc/sudoers.d/90-cloud-init-users ] && sed -i '/^deploy .*NOPASSWD:ALL/d' /etc/sudoers.d/90-cloud-init-users || true
visudo -c >/dev/null
if ! dpkg -s prometheus-bird-exporter >/dev/null 2>&1; then
  DEBIAN_FRONTEND=noninteractive apt-get install -qq -y prometheus-bird-exporter >/dev/null && echo "installed prometheus-bird-exporter"
fi
systemctl daemon-reload
systemctl enable forge-secrets.service >/dev/null 2>&1 || true
systemctl enable --now forge-bgp.path >/dev/null 2>&1 || true
systemctl enable --now prometheus-bird-exporter >/dev/null 2>&1 || echo "prometheus-bird-exporter not started (no bird here?)"
echo "system files installed; run: scripts/deploy <pop>   (refreshes nftables.conf: 9324 on wg0)"
EOT
}

# --- monitor host ---------------------------------------------------------------------
# The monitoring host (docs/monitoring.md) runs no forge, has no deploy helper
# and no secret bundle: everything is installed as root over the bootstrap
# key, the way sysupdate/bootstrap work for a POP. Its only secret is its
# WireGuard private key, rendered into wg0.conf here and shipped 0600 root.
GRAFANA_CONF="$ROOT/infra/monitoring/grafana/apt-repo.conf"

render_monitor_configs() { # render_monitor_configs <mon> <dir>: prometheus.yml + nftables.conf (tofu output or --config-dir), wg0.conf (+ key), repo files
  local mon=$1 dir=$2 key
  if [ -n "$CONFIG_DIR" ]; then
    cp "$CONFIG_DIR"/prometheus.yml "$CONFIG_DIR"/nftables.conf "$dir"/ 2>/dev/null || true
  elif command -v tofu >/dev/null 2>&1 && [ -d "$TOFU_DIR" ] && [ -e "$TOFU_DIR/terraform.tfstate" ]; then
    # Output is a map keyed by monitor name: { mon1 = { prometheus_yml, nftables_conf } }.
    for key in prometheus_yml:prometheus.yml nftables_conf:nftables.conf; do
      tofu -chdir="$TOFU_DIR" output -json monitor_configs 2>/dev/null \
        | python3 -c 'import json,sys; d=json.load(sys.stdin); v=(d.get(sys.argv[1]) or {}).get(sys.argv[2]); sys.stdout.write(v) if v else sys.exit(1)' "$mon" "${key%%:*}" \
        > "$dir/${key#*:}" || rm -f "$dir/${key#*:}"
    done
  fi
  if [ ! -s "$dir/prometheus.yml" ]; then
    [ "$DRY" = 1 ] || die "no rendered prometheus.yml for $mon (tofu output monitor_configs needs state with monitors = { $mon = ... }; or pass --config-dir)"
    log "(dry run) no rendered prometheus.yml; using a placeholder"; echo "# dry-run placeholder" > "$dir/prometheus.yml"
  fi
  [ -s "$dir/nftables.conf" ] || log "no rendered nftables.conf; keeping the host's current one"
  # WireGuard: netgen's config with the private key filled in from SOPS.
  local wg="$ROOT/infra/wireguard/generated/$mon/wg0.conf"
  if [ -s "$wg" ] && [ -s "$BUNDLE" ]; then
    key=$("$ROOT/scripts/secrets" get "$BUNDLE" "wireguard_private_keys.$mon" 2>/dev/null || true)
    if [ -n "$key" ] && [ "${key#REPLACE}" = "$key" ]; then
      (umask 077; WG_KEY="$key" python3 -c 'import os,sys; sys.stdout.write(open(sys.argv[1]).read().replace("__WG_PRIVATE_KEY__", os.environ["WG_KEY"]))' "$wg" > "$dir/wg0.conf")
      if grep -q '__[A-Z0-9_]*__' "$dir/wg0.conf"; then log "WARNING: wg0.conf still has placeholders; not shipping it"; rm -f "$dir/wg0.conf"; fi
    else
      log "WARNING: no wireguard_private_keys.$mon in ${BUNDLE#$ROOT/} (scripts/secrets gen-wg $mon); wg0.conf not shipped"
    fi
  else
    log "no ${wg#$ROOT/} or no secret bundle; wg0.conf not shipped"
  fi
  # Everything else is a plain repository file (rules next to the config so
  # `promtool check config` resolves rule_files: rules/*.yml).
  mkdir -p "$dir/rules"
  cp "$ROOT"/infra/monitoring/prometheus/rules/forge.yml "$dir/rules/"
  cp "$ROOT/infra/monitoring/blackbox.yml" "$dir/"
}

check_monitor_configs() { # check_monitor_configs <dir>: local promtool/nft when installed; the host re-checks before applying
  local dir=$1
  if command -v promtool >/dev/null 2>&1 && [ "$DRY" != 1 ]; then
    (cd "$dir" && promtool check config prometheus.yml >/dev/null) || die "promtool rejected prometheus.yml"
    promtool check rules "$dir/rules/forge.yml" >/dev/null || die "promtool rejected rules/forge.yml"
    log "promtool: prometheus.yml and rules OK"
  else
    log "promtool not run locally; the host checks before reloading"
  fi
  # nft -c needs netlink (CAP_NET_ADMIN) even to check: unprivileged it fails
  # with "Operation not permitted" on every rule, so only check as root.
  if command -v nft >/dev/null 2>&1 && [ -s "$dir/nftables.conf" ] && [ "$(id -u)" = 0 ]; then
    nft -c -f "$dir/nftables.conf" || die "nft rejected nftables.conf"
  fi
}

push_monitor_files() { # push_monitor_files <root@host> <dir>
  local t=$1 dir=$2
  # shellcheck source=../infra/monitoring/grafana/apt-repo.conf
  . "$GRAFANA_CONF"
  log "preparing directories and Grafana (apt key pinned to $GRAFANA_APT_KEY_FPR) as root"
  rscript "$t" "$GRAFANA_APT_KEY_URL" "$GRAFANA_APT_KEY_FPR" "$GRAFANA_APT_REPO" "$GRAFANA_APT_PACKAGE" <<'EOT'
set -e; url=$1; fpr=$2; repo=$3; pkg=$4
export DEBIAN_FRONTEND=noninteractive
install -d -m 0755 /etc/prometheus/rules /etc/apt/keyrings /etc/systemd/system/grafana-server.service.d
if ! dpkg -s "$pkg" >/dev/null 2>&1; then
  command -v gpg >/dev/null 2>&1 || apt-get install -qq -y gnupg >/dev/null
  tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
  curl -fsS --max-time 30 "$url" -o "$tmp/key.asc"
  got=$(gpg --with-colons --import-options show-only --import "$tmp/key.asc" 2>/dev/null | awk -F: '/^fpr/{print $10; exit}')
  [ "$got" = "$fpr" ] || { echo "grafana apt key fingerprint $got does not match the pinned $fpr; not installing" >&2; exit 1; }
  gpg --dearmor < "$tmp/key.asc" > /etc/apt/keyrings/grafana.gpg && chmod 0644 /etc/apt/keyrings/grafana.gpg
  printf '%s\n' "$repo" > /etc/apt/sources.list.d/grafana.list
  apt-get update -qq
  apt-get install -qq -y "$pkg" >/dev/null
  echo "installed $pkg"
fi
install -d -m 0755 /etc/grafana/provisioning/datasources /etc/grafana/provisioning/dashboards
install -d -m 0755 -o grafana -g grafana /var/lib/grafana/dashboards
EOT
  log "installing prometheus.yml, rules, blackbox.yml, Grafana provisioning + dashboard, nftables.conf, wg0.conf as root"
  root_file "$t" "$dir/prometheus.yml" /etc/prometheus/prometheus.yml 0644
  root_file "$t" "$dir/rules/forge.yml" /etc/prometheus/rules/forge.yml 0644
  root_file "$t" "$dir/blackbox.yml" /etc/prometheus/blackbox.yml 0644
  root_file "$t" "$ROOT/infra/monitoring/grafana/provisioning/datasources/prometheus.yml" /etc/grafana/provisioning/datasources/prometheus.yml 0644
  root_file "$t" "$ROOT/infra/monitoring/grafana/provisioning/dashboards/forge.yml" /etc/grafana/provisioning/dashboards/forge.yml 0644
  root_file "$t" "$ROOT/infra/monitoring/grafana/forge-overview.json" /var/lib/grafana/dashboards/forge-overview.json 0644
  root_file "$t" "$ROOT/infra/monitoring/grafana/grafana-server.override.conf" /etc/systemd/system/grafana-server.service.d/forge.conf 0644
  if [ -s "$dir/nftables.conf" ]; then root_file "$t" "$dir/nftables.conf" /etc/nftables.conf 0755; fi
  if [ -s "$dir/wg0.conf" ]; then root_file "$t" "$dir/wg0.conf" /etc/wireguard/wg0.conf 0600; fi
  log "applying: nftables, wg0, prometheus (reload), blackbox, grafana"
  rscript "$t" <<'EOT'
set -e
promtool check config /etc/prometheus/prometheus.yml >/dev/null
if [ -s /etc/nftables.conf ]; then nft -c -f /etc/nftables.conf && systemctl reload-or-restart nftables; fi
systemctl daemon-reload
if [ -s /etc/wireguard/wg0.conf ]; then systemctl enable wg-quick@wg0 >/dev/null 2>&1 || true; systemctl restart wg-quick@wg0; fi
systemctl restart prometheus-blackbox-exporter
systemctl reload-or-restart prometheus
systemctl enable grafana-server >/dev/null 2>&1 || true
systemctl restart grafana-server
sleep 3
for u in nftables wg-quick@wg0 prometheus prometheus-blackbox-exporter grafana-server; do printf '%-32s %s\n' "$u" "$(systemctl is-active "$u" 2>/dev/null || true)"; done
curl -fsS -o /dev/null -w 'prometheus /-/ready: %{http_code}\n' http://127.0.0.1:9090/-/ready || echo "prometheus not ready yet"
wg show wg0 2>/dev/null | grep -E '^peer|handshake' || echo "wg0: no peers or handshakes yet (peers need this host in infra/network/overrides.yaml)"
EOT
}

cmd_monitor() {
  local mon=$1; shift; parse_opts "$@"
  local t h; t=$(root_target "$mon"); h=$(host_only "$t")
  if [ -n "$KH_LINE$KH_FP" ]; then pin_hostkey "$h"; else require_pinned "$h"; fi
  local tmp="$TMP/monitor-$mon"; install -d -m 0700 "$tmp"
  [ "$DRY" = 1 ] && log "DRY RUN for monitor $mon ($t)"
  render_monitor_configs "$mon" "$tmp"
  check_monitor_configs "$tmp"
  push_monitor_files "$t" "$tmp"
  log "deployed monitor $mon; Grafana/Prometheus: ssh -N -L 3000:127.0.0.1:3000 -L 9090:127.0.0.1:9090 -p $PORT deploy@$h"
}

# --- commands -----------------------------------------------------------------------
cmd_deploy() {
  local pop=$1; shift; parse_opts "$@"
  local t; t=$(target "$pop")
  require_pinned "$(host_only "$t")"
  local tmp="$TMP/deploy-$pop"; mkdir -p "$tmp"
  [ "$DRY" = 1 ] && log "DRY RUN for $pop ($t)"
  local bin=$BINARY
  if [ -z "$bin" ]; then bin="$tmp/forge"; build_binary "$bin"; fi
  [ "$DRY" = 1 ] || [ -x "$bin" ] || die "binary $bin not found"
  push_binary "$t" "$bin"
  render_configs "$pop" "$tmp"
  push_configs "$t" "$pop" "$tmp"
  [ "$WITH_SECRETS" = 1 ] && push_secrets "$t" "$pop"
  apply_node "$t"
  smoke "$pop"
  log "deployed $pop"
}

cmd_init_node() {
  local pop=$1; shift; parse_opts "$@"
  local t out h; t=$(target "$pop"); h=$(host_only "$t"); out="$ROOT/infra/secrets/nodes/$pop.age.pub"
  pin_hostkey "$h"
  log "collecting age recipient from $t"
  local recip arg=""
  [ "$ROTATE_KEY" = 1 ] && arg=rotate
  recip=$(helper "$t" init-node $arg)
  [ "$DRY" = 1 ] && return 0
  case "$recip" in age1*) ;; *) die "unexpected recipient '$recip'";; esac
  install -d "$(dirname "$out")"; printf '%s\n' "$recip" > "$out"
  log "wrote ${out#$ROOT/}"
  echo "$recip"
  [ "$ROTATE_KEY" = 1 ] && echo "old key kept as /etc/forge/age.key.old until the next successful 'deploy $pop'." >&2
  echo "commit ${out#$ROOT/} and ${KNOWN_HOSTS#$ROOT/}; add the recipient to .sops.yaml only if this node should decrypt whole bundles (not needed for deploy)." >&2
}

cmd_sysupdate() {
  local pop=$1; shift; parse_opts "$@"
  local t; t=$(root_target "$pop")
  require_pinned "$(host_only "$t")"
  push_system_files "$t"
}

cmd_bootstrap() { # minimal equivalent of the cloud-init for a hand-installed Debian 13 box
  local pop=$1; shift; parse_opts "$@"
  [ -n "$HOST" ] || die "bootstrap needs --host root@host (port $PORT or set FORGE_ADMIN_PORT=22 for the first run)"
  local t=$HOST h; h=$(host_only "$t")
  pin_hostkey "$h"
  log "bootstrapping $pop on $t (packages, users, sshd :2200, helper, units, age key)"
  local keys=""; [ -r "$HOME/.ssh/id_ed25519.pub" ] && keys=$(cat "$HOME/.ssh/id_ed25519.pub")
  rscript "$t" "$pop" "$(printf %q "$keys")" <<'EOT'
set -e; pop=$1; key=$2
export DEBIAN_FRONTEND=noninteractive
apt-get update -qq && apt-get install -qq -y git bird2 wireguard-tools nftables curl ca-certificates age zstd unattended-upgrades prometheus-node-exporter >/dev/null
id forge >/dev/null 2>&1 || useradd --system --home-dir /var/lib/forge --create-home --shell /usr/sbin/nologin forge
id deploy >/dev/null 2>&1 || useradd --create-home --shell /bin/bash --groups forge deploy
if [ -n "$key" ]; then install -d -m 0700 -o deploy -g deploy /home/deploy/.ssh; grep -qxF "$key" /home/deploy/.ssh/authorized_keys 2>/dev/null || echo "$key" >> /home/deploy/.ssh/authorized_keys; chown deploy:deploy /home/deploy/.ssh/authorized_keys; chmod 0600 /home/deploy/.ssh/authorized_keys; fi
install -d -m 0750 -o forge -g forge /var/lib/forge; install -d -m 0750 -o root -g forge /etc/forge; install -d -m 0700 /var/backups/forge
printf 'FORGE_NODE=%s\n' "$pop" > /etc/forge/node.env
EOT
  push_system_files "$t"
  rscript "$t" <<'EOT'
set -e
/usr/local/sbin/forge-deploy-helper init-node >/dev/null
systemctl enable --now forge-secrets.service
printf 'Port 2200\nPasswordAuthentication no\nKbdInteractiveAuthentication no\nPermitRootLogin prohibit-password\nAllowUsers root deploy\n' > /etc/ssh/sshd_config.d/10-forge.conf
systemctl is-enabled ssh.socket >/dev/null 2>&1 && systemctl disable --now ssh.socket || true
sshd -t && systemctl restart ssh
echo "bootstrapped $pop; sshd now on 2200; age recipient $(cat /etc/forge/age.pub)"
EOT
  # the host key is the same on 2200: pin it under that name too so the next commands need no flags
  if [ "$PORT" != 2200 ] && [ "$DRY" != 1 ]; then
    local line; line=$(ssh-keygen -F "$(kh_name "$h")" -f "$KNOWN_HOSTS" | grep -v '^#' | head -1)
    set -- $line; PORT=2200 kh_has "$h" || PORT=2200 kh_add "$h" "$2" "$3"
  fi
  log "next: FORGE_ADMIN_PORT=2200 scripts/deploy init-node $pop --host deploy@$h; then deploy $pop --config-dir <dir with forge.toml + nftables.conf>"
}

cmd_rollback() {
  local pop=$1; shift; parse_opts "$@"
  local t; t=$(target "$pop"); require_pinned "$(host_only "$t")"
  log "rolling back binary on $pop"
  helper "$t" rollback
  smoke "$pop"
}

cmd_announce() { # drain|undrain
  local action=$1 pop=$2; shift 2; parse_opts "$@"
  local t; t=$(target "$pop"); require_pinned "$(host_only "$t")"
  log "$action $pop via forge-deploy-helper $action (bgp-announce on the node)"
  helper "$t" "$action"
}

cmd_status() {
  local pop=$1; shift; parse_opts "$@"
  local t; t=$(target "$pop"); require_pinned "$(host_only "$t")"
  helper "$t" status
}

main() {
  [ $# -ge 1 ] || usage 1
  case "$1" in
    -h|--help|help) usage 0;;
    init-node) shift; [ $# -ge 1 ] || usage 1; cmd_init_node "$@";;
    sysupdate) shift; [ $# -ge 1 ] || usage 1; cmd_sysupdate "$@";;
    bootstrap) shift; [ $# -ge 1 ] || usage 1; cmd_bootstrap "$@";;
    rollback) shift; [ $# -ge 1 ] || usage 1; cmd_rollback "$@";;
    drain|undrain) a=$1; shift; [ $# -ge 1 ] || usage 1; cmd_announce "$a" "$@";;
    status) shift; [ $# -ge 1 ] || usage 1; cmd_status "$@";;
    smoke) shift; [ $# -ge 1 ] || usage 1; pop=$1; shift; parse_opts "$@"; smoke "$pop";;
    monitor) shift; [ $# -ge 1 ] || usage 1; cmd_monitor "$@";;
    -*) usage 1;;
    *) cmd_deploy "$@";;
  esac
}
main "$@"
