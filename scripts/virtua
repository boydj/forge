#!/usr/bin/env bash
# Virtua.Cloud API client (https://api.virtua.cloud/v1/, X-API-Key header).
# Used to provision a forge POP on Virtua for provider diversity (M9).
#
#   scripts/virtua account | projects | offers [region] | systems
#   scripts/virtua create --project UUID --offer UUID --system UUID --hostname NAME [--no-ipv6]
#   scripts/virtua show UUID | password UUID | delete UUID | wait UUID
#
# The key comes from $VIRTUA_API_KEY or the SOPS bundle (virtua_api_key):
#   eval "$(scripts/secrets env infra/secrets/dev.enc.yaml)"
#
# Note: the create call has no SSH-key or cloud-init field, so a new server
# comes up with a root password (scripts/virtua password UUID). Bootstrap it
# with `scripts/deploy bootstrap sfo1 --host root@<ip>` (packages, users,
# sshd:2200, helper, units, age key), then `scripts/deploy sfo1`. BGP is NOT
# in this API: request the session in the Virtua customer area, then fill the
# peer details into infra/network/address-plan.yaml and regenerate BIRD.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BASE="${VIRTUA_API_BASE:-https://api.virtua.cloud/v1}"

key() {
  local k="${VIRTUA_API_KEY:-}"
  [ -z "$k" ] && k="$("$ROOT/scripts/secrets" get "$ROOT/infra/secrets/dev.enc.yaml" virtua_api_key 2>/dev/null || true)"
  case "$k" in ""|REPLACE*|KEYID*) echo "no VIRTUA_API_KEY (set it or add virtua_api_key to infra/secrets/dev.enc.yaml)" >&2; exit 2;; esac
  printf '%s' "$k"
}
api() { # api METHOD PATH [json-body]
  local m=$1 p=$2 body=${3:-}
  local args=(-sS -m 60 -X "$m" -H "X-API-Key: $(key)" -H "Accept: application/json")
  [ -n "$body" ] && args+=(-H "Content-Type: application/json" --data "$body")
  curl "${args[@]}" "$BASE$p"
}
jq_() { python3 -c 'import json,sys; d=json.load(sys.stdin); print(json.dumps(d,indent=2))'; }

cmd=${1:-}; shift || true
case "$cmd" in
  account)  api GET /account | jq_ ;;
  projects) api GET /project | python3 -c 'import json,sys;[print(p.get("uuid"),p.get("name")) for p in json.load(sys.stdin).get("projects",[])]' ;;
  systems)  api GET /cloud/systems | python3 -c 'import json,sys;[print(s.get("uuid"),s.get("name",s.get("label",""))) for s in json.load(sys.stdin).get("systems",[])]' ;;
  offers)   region=${1:-}
            api GET /cloud/offers | python3 -c 'import json,sys;r=sys.argv[1] if len(sys.argv)>1 else "";[print(o.get("uuid"),o.get("cloud_zone",o.get("region","")),o.get("name",o.get("label","")),o.get("price","")) for o in json.load(sys.stdin).get("offers",[]) if not r or r.lower() in json.dumps(o).lower()]' "$region" ;;
  create)   proj= offer= system= host= ipv6=true
            while [ $# -gt 0 ]; do case $1 in --project) proj=$2;shift 2;; --offer) offer=$2;shift 2;; --system) system=$2;shift 2;; --hostname) host=$2;shift 2;; --no-ipv6) ipv6=false;shift;; *) echo "unknown $1">&2;exit 2;; esac; done
            [ -n "$proj$offer$system$host" ] || { echo "create needs --project --offer --system --hostname">&2; exit 2; }
            body=$(python3 -c 'import json,sys; print(json.dumps({"PROJECT_UUID":sys.argv[1],"OFFER_UUID":sys.argv[2],"SYSTEM_UUID":sys.argv[3],"hostname":sys.argv[4],"ipv6_enabled":sys.argv[5]=="true","ipv6_block_size":64}))' "$proj" "$offer" "$system" "$host" "$ipv6")
            api POST /cloud-server "$body" | jq_ ;;
  show)     api GET "/cloud-server/${1:?UUID}" | jq_ ;;
  password) api GET "/cloud-server/${1:?UUID}/password" | jq_ ;;
  delete)   api DELETE "/cloud-server/${1:?UUID}" | jq_ ;;
  wait)     u=${1:?UUID}; for i in $(seq 1 60); do s=$(api GET "/cloud-server/$u" | python3 -c 'import json,sys;d=json.load(sys.stdin);print(d.get("is_suspended"),d.get("cloud_zone",""))' 2>/dev/null||true); echo "  $s"; echo "$s"|grep -qi 'false' && { echo ready; break; }; sleep 5; done ;;
  *) sed -n '2,20p' "$0"; exit 2 ;;
esac
