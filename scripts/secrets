#!/usr/bin/env bash
# scripts/secrets: SOPS + age helper for the forge (docs/secrets.md).
#
#   secrets init                    create the operator age key (~/.config/forge/age.key), print recipient
#   secrets edit <file.enc.yaml>    create-or-edit a bundle (seeded from infra/secrets/schema.example.yaml)
#   secrets view <file.enc.yaml>    decrypt to stdout
#   secrets env  <file.enc.yaml>    print `export VULTR_API_KEY=... CLOUDFLARE_API_TOKEN=...` for tofu
#   secrets get  <file.enc.yaml> <key>   print one value (dotted path, e.g. wireguard_private_keys.ewr1)
#   secrets gen-wg <pop>            generate a WireGuard key pair; print YAML snippet + public key
#   secrets gen-tls <hostname>      generate the service TLS key + self-signed cert (P-256, notAfter 2036)
#   secrets gen-hostkey             generate the shared Ed25519 SSH host key; print SSHFP
#   secrets gen-cluster             generate cluster_secret
#   secrets gen-backup-key          generate the backup age identity
#   secrets rotate <what>           print the rotation procedure for: tls|hostkey|wg|bgp|cluster|backup|api|operator
#   secrets updatekeys <file>       re-encrypt to the recipients in .sops.yaml
#
# Generated material is printed to stdout (or written under a --out dir with
# mode 0600) for you to paste into `secrets edit`; nothing is written into the
# repository by this script.
set -euo pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd)
KEY_DIR=${FORGE_KEY_DIR:-$HOME/.config/forge}
KEY_FILE=${SOPS_AGE_KEY_FILE:-$KEY_DIR/age.key}
export SOPS_AGE_KEY_FILE="$KEY_FILE"
EXAMPLE="$ROOT/infra/secrets/schema.example.yaml"

die() { echo "secrets: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "$1 is required (make tools-infra)"; }
usage() { sed -n '2,/^set -euo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

cmd_init() {
  need age-keygen
  if [ -s "$KEY_FILE" ]; then
    echo "operator key exists: $KEY_FILE" >&2
  else
    install -d -m 0700 "$KEY_DIR"
    (umask 077 && age-keygen -o "$KEY_FILE" 2>/dev/null)
    echo "wrote $KEY_FILE (mode 0600). Back it up offline; without it nothing decrypts." >&2
  fi
  recipient=$(age-keygen -y "$KEY_FILE")
  echo "recipient: $recipient"
  echo "put it in .sops.yaml (replace age1operatorplaceholder...), then: scripts/secrets edit infra/secrets/dev.enc.yaml" >&2
}

require_key() { [ -s "$KEY_FILE" ] || die "no operator key at $KEY_FILE; run: scripts/secrets init"; }

cmd_edit() {
  need sops; require_key
  f=${1:?file}; case "$f" in *.enc.yaml) ;; *) die "file must end in .enc.yaml (matches .sops.yaml)";; esac
  if [ ! -e "$f" ]; then
    grep -q 'age1operatorplaceholder' "$ROOT/.sops.yaml" && die ".sops.yaml still has the placeholder recipient; run scripts/secrets init and edit it"
    install -d "$(dirname "$f")"
    # Seed from the example, encrypt in place, then open the editor.
    # Rules match on the *target* path; the example lives elsewhere.
    (cd "$ROOT" && sops --encrypt --input-type yaml --output-type yaml --filename-override "$f" "$EXAMPLE" > "$f")
    echo "created $f from $EXAMPLE; replace every REPLACE value" >&2
  fi
  # exit 200 = "file has not changed": not an error for us.
  (cd "$ROOT" && sops "$f") || { rc=$?; [ "$rc" -eq 200 ] || exit "$rc"; }
}

cmd_view() { need sops; require_key; (cd "$ROOT" && sops --decrypt "${1:?file}"); }

cmd_get() {
  need sops; require_key
  f=${1:?file}; key=${2:?key}
  # dotted path -> sops --extract '["a"]["b"]'
  path=""; IFS=. read -ra parts <<<"$key"; for p in "${parts[@]}"; do path+="[\"$p\"]"; done
  (cd "$ROOT" && sops --decrypt --extract "$path" "$f")
}

cmd_env() {
  need sops; require_key
  f=${1:?file}
  for pair in VULTR_API_KEY:vultr_api_key CLOUDFLARE_API_TOKEN:cloudflare_api_token; do
    var=${pair%%:*}; key=${pair#*:}
    val=$(cmd_get "$f" "$key" 2>/dev/null || true)
    case "$val" in ""|REPLACE*) echo "# $var: not set in $f" ;; *) printf 'export %s=%q\n' "$var" "$val" ;; esac
  done
  echo "# usage: eval \"\$(scripts/secrets env $f)\"; unset with: unset VULTR_API_KEY CLOUDFLARE_API_TOKEN"
}

wg_keypair() {
  # Prefer wg(8); fall back to openssl (WireGuard keys are raw X25519, base64).
  if command -v wg >/dev/null 2>&1; then
    priv=$(wg genkey); pub=$(printf '%s' "$priv" | wg pubkey)
  else
    need openssl
    der=$(openssl genpkey -algorithm X25519 -outform DER 2>/dev/null | base64 -w0)
    priv=$(printf '%s' "$der" | base64 -d | tail -c 32 | base64 -w0)
    pub=$(printf '%s' "$der" | base64 -d | openssl pkey -inform DER -pubout -outform DER 2>/dev/null | tail -c 32 | base64 -w0)
  fi
  printf '%s %s\n' "$priv" "$pub"
}

cmd_gen_wg() {
  pop=${1:?pop}
  read -r priv pub < <(wg_keypair)
  cat <<EOT
# paste into wireguard_private_keys in the bundle:
wireguard_private_keys:
  $pop: "$priv"
# public key for infra/network/address-plan.yaml (pops.$pop.wireguard.public_key):
$pub
EOT
}

cmd_gen_tls() {
  need openssl
  host=${1:?hostname}
  tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
  # ECDSA P-256: universally supported by Gemini clients (unlike Ed25519 in
  # some TLS stacks), small, fast. Self-signed: Gemini is TOFU, no CA.
  # Long validity (to 2036-01-01) because every rotation breaks every
  # client's pinned fingerprint; rotate on compromise, not on a calendar.
  openssl ecparam -name prime256v1 -genkey -noout -out "$tmp/key.pem" 2>/dev/null
  openssl pkey -in "$tmp/key.pem" -out "$tmp/key8.pem" 2>/dev/null
  # -days rather than -not_after: the latter needs OpenSSL >= 3.4.
  days=$(( ( $(date -u -d 2036-01-01 +%s) - $(date -u +%s) ) / 86400 ))
  openssl req -new -x509 -key "$tmp/key8.pem" -out "$tmp/cert.pem" -sha256 \
    -subj "/CN=$host" -days "$days" \
    -addext "subjectAltName=DNS:$host" -addext "keyUsage=digitalSignature" \
    -addext "extendedKeyUsage=serverAuth" 2>/dev/null
  echo "# paste into the bundle:"
  echo "forge_tls_key: |"; sed 's/^/  /' "$tmp/key8.pem"
  echo "forge_tls_cert: |"; sed 's/^/  /' "$tmp/cert.pem"
  echo "# fingerprint (publish on the home page):"
  openssl x509 -in "$tmp/cert.pem" -noout -fingerprint -sha256 | sed 's/^/# /'
  openssl x509 -in "$tmp/cert.pem" -noout -enddate | sed 's/^/# /'
}

cmd_gen_hostkey() {
  need ssh-keygen
  tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
  ssh-keygen -q -t ed25519 -N '' -C "git@${1:-git.as215520.net}" -f "$tmp/host_ed25519"
  echo "# paste into the bundle:"
  echo "ssh_host_key: |"; sed 's/^/  /' "$tmp/host_ed25519"
  echo "# public key / SSHFP (type 2 line goes into tfvars sshfp):"
  sed 's/^/# /' "$tmp/host_ed25519.pub"
  ssh-keygen -r "${1:-git.as215520.net}" -f "$tmp/host_ed25519.pub" | grep ' 2 ' | sed 's/^/# /'
}

cmd_gen_cluster() { need openssl; printf 'cluster_secret: "%s"\n' "$(openssl rand -hex 32)"; }

cmd_gen_backup_key() {
  need age-keygen
  tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
  (umask 077 && age-keygen -o "$tmp/backup.key" 2>/dev/null) # age-keygen refuses to overwrite
  printf 'backup_encryption_key: "%s"\n' "$(grep AGE-SECRET-KEY "$tmp/backup.key")"
  printf '# recipient pushed to nodes as /etc/forge/secrets/backup.recipient:\n# %s\n' "$(age-keygen -y "$tmp/backup.key")"
}

cmd_updatekeys() { need sops; require_key; (cd "$ROOT" && sops updatekeys "${1:?file}"); }

cmd_rotate() {
  case "${1:-}" in
    tls) cat <<'EOT'
TLS (forge_tls_key/cert): every Gemini client that pinned the old cert will
prompt. 1) gen-tls, paste both into the bundle. 2) deploy every POP in one
sitting (anycast: mixed certs across POPs look like MITM). 3) publish the
new fingerprint on the home page and in the announcement feed.
EOT
;;
    hostkey) cat <<'EOT'
SSH host key: 1) gen-hostkey, paste; 2) update `sshfp` in tfvars and apply DNS
(new SSHFP alongside old is fine); 3) deploy all POPs together; 4) remove the
old SSHFP. Users with old known_hosts entries get the usual warning.
EOT
;;
    wg) cat <<'EOT'
WireGuard: 1) gen-wg <pop>, paste private key; put the public key into
address-plan.yaml; 2) regenerate configs (scripts/netgen); 3) deploy the
rotated POP, then every peer (their wg0.conf carries the new public key).
EOT
;;
    bgp) cat <<'EOT'
BGP MD5: the password is changed on Vultr's side via support ticket / BGP
page, then in the bundle, then `deploy <pop>` per Vultr POP. Sessions flap
once per POP; drain first (`scripts/deploy drain <pop>`).
EOT
;;
    cluster) echo "cluster_secret: gen-cluster, paste, deploy all POPs (replication pauses until all agree).";;
    backup) echo "backup key: gen-backup-key, paste, deploy all POPs; keep the OLD identity to read old backups.";;
    api) echo "API keys: rotate in the provider console, `secrets edit` the bundle; nothing to deploy.";;
    operator) cat <<'EOT'
Operator key: new operator runs `secrets init`, sends the recipient; add it to
.sops.yaml; `secrets updatekeys <every bundle>`; commit. Remove a departed
operator the same way (and rotate everything they could read).
EOT
;;
    *) echo "rotate: tls|hostkey|wg|bgp|cluster|backup|api|operator"; exit 1;;
  esac
}

case "${1:-}" in
  init) cmd_init;;
  edit) cmd_edit "${2:-}";;
  view) cmd_view "${2:-}";;
  get) cmd_get "${2:-}" "${3:-}";;
  env) cmd_env "${2:-}";;
  gen-wg) cmd_gen_wg "${2:-}";;
  gen-tls) cmd_gen_tls "${2:-}";;
  gen-hostkey) cmd_gen_hostkey "${2:-}";;
  gen-cluster) cmd_gen_cluster;;
  gen-backup-key) cmd_gen_backup_key;;
  rotate) cmd_rotate "${2:-}";;
  updatekeys) cmd_updatekeys "${2:-}";;
  -h|--help|help|"") usage 0;;
  *) echo "secrets: unknown command $1" >&2; usage 1;;
esac
